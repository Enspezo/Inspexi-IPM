# Runtime environment: development | production | test
# LET OP (beveiliging): zet dit op 'production' in elke gedeelde (test/prod)
# omgeving. Het stuurt o.a. de JWT-uniekheidscontrole, cookie 'secure'-vlag en de
# throttler aan. 'test' schakelt de rate-limiting UIT (alleen voor de E2E-suite).
NODE_ENV=development

# Database (shared PostgreSQL with InspeXi inspectie-backend)
# De DB-gebruiker heeft rechten nodig voor CREATE EXTENSION (ltree, pg_trgm).
DATABASE_URL=postgresql://inspectie:inspectie_dev_password@localhost:5433/inspectie?schema=public

# JWT Authentication
# LET OP: de app weigert te starten wanneer één van de vier secrets ontbreekt of
# nog op de letterlijke waarde "change-me-in-production" staat. In PRODUCTIE
# moeten alle vier bovendien UNIEK zijn. Genereer sterke, unieke waarden, bijv.:
#   openssl rand -hex 32
# De onderstaande dev-placeholders zijn bewust onderling verschillend zodat een
# verse kopie lokaal boot — vervang ze vóór elke deploy.
JWT_SECRET=dev-only-jwt-secret-vervang-mij-0001
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-vervang-mij-0002
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
# Sessieduur wanneer "Onthoud mij" is uitgezet (kortere, glijdende sessie)
JWT_REFRESH_SHORT_EXPIRATION=12h

# Client-portal auth realm (2e realm — APARTE secrets t.o.v. de staf-JWT; token type:'client')
# orgId zit NOOIT in dit token — de org komt uit het subdomein (TenantMiddleware).
CLIENT_JWT_SECRET=dev-only-client-jwt-secret-vervang-mij-0003
CLIENT_JWT_REFRESH_SECRET=dev-only-client-jwt-refresh-secret-vervang-mij-0004
CLIENT_JWT_EXPIRATION=1h
CLIENT_JWT_REFRESH_EXPIRATION=30d

# Resend (email service)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.nl
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret

# Public URL (STAF-portal — gebruikt in e-mail-links: reset, uitnodiging, offerte,
# ondertekenverzoek). Eén statieke host (geen per-org subdomein-templating).
PUBLIC_URL=http://localhost:5173

# Public URL van het KLANT-portaal (client-portal, 4e app). Gebruikt voor de
# wachtwoord-reset-links van klantgebruikers; valt terug op PUBLIC_URL als leeg.
CLIENT_PUBLIC_URL=http://localhost:5174

# Publieke basis-URL van de API zelf (voor o.a. uitschrijf-links in notificatie-
# mails). Zonder waarde valt de code terug op http://localhost:${API_PORT}.
API_BASE_URL=http://localhost:3000

# Swagger UI op /api/docs. Onbeheerd publiceert dit het volledige API-oppervlak.
# Leeg = AAN buiten productie, UIT in productie. Zet expliciet 'true'/'false' om
# te overschrijven.
SWAGGER_ENABLED=

# API Port
API_PORT=3000

# Multi-tenancy (subdomain routing)
# Dev:  BASE_DOMAIN=localhost, PORTAL_PORT=5173
# Prod: BASE_DOMAIN=inspexi.nl, PORTAL_PORT=443
BASE_DOMAIN=localhost
PORTAL_PORT=5173
SUPERUSER_SUBDOMAIN=mijn

# Client-portal (4e app, Fase 6) — draait standaard op een subdomein van BASE_DOMAIN
# (bijv. inspexidemo.localhost:5174) en valt dan al onder de CORS-/tenant-resolutie.
# CLIENT_PORTAL_BASE_DOMAIN alleen invullen als de client-portal in PROD op een EIGEN
# basisdomein draait (dan worden dat domein + subdomeinen extra in de CORS-allowlist gezet).
CLIENT_PORTAL_BASE_DOMAIN=

# Seed: wachtwoordloze demo magic-links (directe klant-login zonder wachtwoord).
# ALLEEN voor lokale demo's. Zet op '1' om de vaste magic-link-tokens
# (demo-klant-magic + variant-tokens) aan te maken; standaard-seed laat ze weg.
# De aangemaakte links verlopen na 30 dagen.
SEED_DEMO=0

# File uploads
UPLOAD_DIR=./uploads

# Document generatie (Puppeteer → PDF)
# Pad naar de Chromium-binary in productie/container. Leeg laten = puppeteer's
# eigen meegeleverde Chromium wordt gebruikt (lokaal/dev).
PUPPETEER_EXECUTABLE_PATH=
# Max. aantal gelijktijdige PDF-renders (semafoor). Leeg = default 3.
PDF_MAX_CONCURRENCY=

# Meetmiddelen: aantal dagen vóór kalibratie-vervaldatum waarop gewaarschuwd wordt
# (herinnerings-scheduler + "bijna verlopen"-status). Leeg = code-default.
MEETMIDDEL_KALIBRATIE_DREMPEL_DAGEN=

# KvK Handelsregister API
# Vraag een API-sleutel aan via https://developers.kvk.nl/
# Zonder sleutel wordt de publieke test-omgeving gebruikt
KVK_API_KEY=l7xx1f2691f2520d487185dbc7ab0d1cc2cf
# Zet op 'false' in productie om de echte KvK API te gebruiken
KVK_USE_TEST_ENV=true

# Convert API (DOCX → PDF microservice)
# Dev:  http://localhost:3002
# Prod: https://convert.inspexi.nl
CONVERT_API_URL=http://localhost:3002
CONVERT_API_KEY=change-me-in-production

# Anthropic (voice-parsing — Fase 7; AI-voorcontrole — PRD-13)
# Eén sleutel voor alle AI-functies (gedeelde AnthropicClientService); zonder
# sleutel zijn voice-parsing én AI-review uitgeschakeld (GET /voice/status en
# GET /ai-review/status → available:false). Modellen per functie configureerbaar;
# default = claude-sonnet-4-6.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_REVIEW_MODEL=claude-sonnet-4-6

# AI-assistent (add-on). Deelt ANTHROPIC_API_KEY (centrale beheerde key).
# Eigen model-var (zelfde patroon als ANTHROPIC_REVIEW_MODEL) zodat de
# voice-module (ANTHROPIC_MODEL) niet wordt beïnvloed.
# Default = claude-sonnet-5 (kosten-effectief); zet op claude-opus-4-8 voor premium.
ANTHROPIC_AGENT_MODEL=claude-sonnet-5
# Ruim maandelijks token-plafond per org (fair-use, geen per-token-doorbelasting).
AI_AGENT_MONTHLY_TOKEN_QUOTA=5000000

# PDOK / BAG (adres-geocoding + BAG-bouwgegevens voor locaties)
# Locatieserver = adres-suggest/lookup; BAG OGC API = keyless bouwgegevens
# (gebruiksfunctie/bouwjaar/oppervlakte/pand-id). Defaults werken zonder sleutel.
PDOK_LOCATIESERVER_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1
PDOK_BAG_OGC_URL=https://api.pdok.nl/kadaster/bag/ogc/v2
# De best-effort luchtfoto wordt client-side gerenderd in de portal; overschrijf
# de WMS-base-URL daar via de portal-env `VITE_PDOK_LUCHTFOTO_WMS_URL` (geen API-var).

# Sync-tombstone-cleanup (dagelijkse cron 03:00): hard-delete van sync-tombstones
# die > TOMBSTONE_RETENTION_DAYS (90) geleden soft-deleted zijn. Default AAN;
# alleen '0' of 'false' (case-insensitief) schakelt de job uit. Zet uit als je de
# retentie-horizon tijdelijk wilt bevriezen (bv. bij een grote offline-device-migratie).
TOMBSTONE_CLEANUP_ENABLED=true

# Urenregistratie-crons (PRD-16): de nachtwaker (elk half uur — stopt timers die
# na hun lokale kalenderdag nog lopen) en de ping-retentie (elk uur — verwijdert
# locatie-pings ouder dan 48u). Default AAN; alleen '0' of 'false' (case-
# insensitief) schakelt beide uit. Zet uit op extra API-instanties zodat de
# nachtwaker niet meerdere keren tegelijk draait.
TIME_TRACKING_SCHEDULER_ENABLED=true

# Storage driver: local (default) | r2
STORAGE_DRIVER=local

# Cloudflare R2 (S3-compatible) — alleen vereist als STORAGE_DRIVER=r2.
# Bij STORAGE_DRIVER=local worden deze niet gelezen en mogen ze leeg/afwezig zijn
# (de R2-provider wordt dan niet geïnstantieerd).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
