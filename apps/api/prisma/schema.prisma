// ─── PRD-01: Foundation Models ───────────────────────────

model Organization {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  logoUrl             String?  @map("logo_url")
  primaryColor        String?  @map("primary_color")
  defaultVat          Float    @default(21) @map("default_vat")
  defaultValidityDays Int      @default(30) @map("default_validity_days")
  senderName          String?  @map("sender_name")
  senderEmail         String?  @map("sender_email")
  timezone            String   @default("Europe/Amsterdam")
  workdayStart        Int      @default(8) @map("workday_start")
  workdayEnd          Int      @default(17) @map("workday_end")
  isActive            Boolean  @default(true) @map("is_active")
  // Interne chat per organisatie aan/uit (REQ1) — te schakelen door SUPERUSER/ORG_ADMIN.
  chatEnabled         Boolean  @default(true) @map("chat_enabled")
  // SaaS-abonnement (entitlements, PRD-09): template-plan voor deze org. Nullable —
  // een org zonder plan heeft (buiten core) geen gegate functies.
  planId              String?  @map("plan_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")

  // Zichtbaarheid inspecteur-contactgegevens in klantportaal (per kanaal onafhankelijk).
  // De getoonde waarde wordt altijd server-side geresolved (zie resolveInspectorContact).
  inspectorPhoneDisplay ContactDisplayMode @default(NONE) @map("inspector_phone_display")
  inspectorEmailDisplay ContactDisplayMode @default(NONE) @map("inspector_email_display")
  inspectorStaticPhone  String?            @map("inspector_static_phone")
  inspectorStaticEmail  String?            @map("inspector_static_email")

  // Offerte-goedkeuring drempel (REQ5): offertes met `total` strikt boven dit bedrag
  // mogen niet verstuurd worden zonder goedkeuring door iemand met `quoteApprovalRequiredRole`.
  // Beide null → geen verplichte drempel (val terug op template-`requiresApproval`).
  quoteApprovalThreshold    Decimal? @map("quote_approval_threshold") @db.Decimal(12, 2)
  quoteApprovalRequiredRole Role?    @map("quote_approval_required_role")

  // Support-toegang (PRD-10): expliciete, geauditeerde consent voor InspeXi-support.
  supportAccessEnabled   Boolean   @default(false) @map("support_access_enabled")
  supportAccessExpiresAt DateTime? @map("support_access_expires_at")

  // Inspectie-review (vier-ogen + AI-voorcontrole, PRD-13)
  inspectionReviewEnabled Boolean @default(true) @map("inspection_review_enabled")
  aiReviewEnabled         Boolean @default(false) @map("ai_review_enabled")
  aiReviewInstructions    String? @map("ai_review_instructions") @db.Text

  users                    User[]
  invitations              Invitation[]
  contacts                 Contact[]
  contactPersons           ContactPerson[]
  customerGroups           CustomerGroup[]
  locations                Location[]
  productGroups            ProductGroup[]
  products                 Product[]
  priceTables              PriceTable[]
  requests                 Request[]
  quoteTemplates           QuoteTemplate[]
  quotes                   Quote[]
  notifications            Notification[]
  notificationGroupPrefs   NotificationGroupPref[]
  tasks                    Task[]
  documents                Document[]
  documentTags             DocumentTag[]
  notes                    Note[]
  favorites                Favorite[]
  planningItems            PlanningItem[]
  customFieldDefinitions   CustomFieldDefinition[]
  numberingSchemes         NumberingScheme[]
  emailTemplates           EmailTemplate[]
  emailTemplateAttachments EmailTemplateAttachment[]
  projects                 Project[]
  errorReports             ErrorReport[]
  workOrders               WorkOrder[]
  locationContactPersons   LocationContactPerson[]
  lostReasons              LostReason[]
  contactPersonRoles       ContactPersonRoleOption[]
  projectPhases            ProjectPhase[]
  phaseMilestones          PhaseMilestone[]

  // Inspectiedomein (Fase 1)
  normConfigurations       NormConfiguration[]
  inspectionPlans          InspectionPlan[]
  assetNodes               AssetNode[]
  inspectionPlanLocations  InspectionPlanLocation[]
  visualInspections        VisualInspection[]
  measurementRecords       MeasurementRecord[]
  findings                 Finding[]
  inspectionPhotos         Photo[]
  inspectionSignatures     Signature[]
  reports                  Report[]
  checklistItems           ChecklistItem[]
  checklists               Checklist[]
  categories               Category[]
  findingTemplates         FindingTemplate[]
  reportTemplates          ReportTemplate[]
  assetTypeDefinitions     AssetTypeDefinition[]
  locationTypeDefinitions  LocationTypeDefinition[]
  inspectionTemplates      InspectionTemplate[]
  generatedDocuments       GeneratedDocument[]
  measurementSheetRecords  MeasurementSheetRecord[]
  standaloneMeasurements   StandaloneMeasurement[]
  locationImages           LocationImage[]
  locationImageMarkers     LocationImageMarker[]
  clientRequests           ClientRequest[]
  voiceTemplatePrompts     VoiceTemplatePrompt[]
  // Per-org lookup-tabellen (overschrijfbare status/type-lijsten)
  inspectionTypeOptions    InspectionTypeOption[]
  planStatusTypes          PlanStatusType[]
  assetStatusTypes         AssetStatusType[]
  findingStatusTypes       FindingStatusType[]
  reportStatusTypes        ReportStatusType[]
  signatoryTypeOptions     SignatoryTypeOption[]
  signerRoleOptions        SignerRoleOption[]
  passFailStatusTypes      PassFailStatusType[]
  resolutionStatusTypes    ResolutionStatusType[]
  clientRequestTypeOptions ClientRequestTypeOption[]
  clientRequestStatusTypes ClientRequestStatusType[]
  pdokApiLogs              PdokApiLog[]

  // Interne chat (REQ1)
  chatThreads  ChatThread[]
  chatMessages ChatMessage[]

  // SaaS-abonnement (entitlements, PRD-09)
  plan     Plan?                 @relation(fields: [planId], references: [id])
  features OrganizationFeature[]

  // Helpsysteem (PRD-10)
  helpCategories    HelpCategory[]
  helpArticles      HelpArticle[]
  supportTickets    SupportTicket[]
  supportAccessLogs SupportAccessLog[]

  // Inspecteur-certificaten (PRD-11)
  inspectorCertificates InspectorCertificate[]

  // Meetmiddelen
  measurementInstruments           MeasurementInstrument[]
  calibrations                     Calibration[]
  userDefaultInstruments           UserDefaultInstrument[]
  inspectionPlanDefaultInstruments InspectionPlanDefaultInstrument[]

  // Beschikbaarheid inspecteurs (PRD-12)
  availabilityTemplates   AvailabilityTemplate[]
  userScheduleAssignments UserScheduleAssignment[]
  availabilityExceptions  AvailabilityException[]

  // AI-review van inspectierapporten (PRD-13)
  aiReviewRuns AiReviewRun[]

  @@map("imp_organizations")
}

// ─── SaaS-abonnementen & feature-entitlements (PRD-09) ───
// De feature-catalogus (keys/labels/afhankelijkheden) leeft in code
// (packages/entitlements — @inspexi/entitlements). Deze tabellen slaan alleen
// plannen (templates) en per-org-afwijkingen op die naar feature-keys verwijzen.

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  name        String // "Basis", "Compleet"
  slug        String   @unique // regex ^[a-z0-9]+$ (geen hyphens!)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  features      PlanFeature[]
  organizations Organization[]

  @@map("imp_plans")
}

model PlanFeature {
  id         String @id @default(uuid()) @db.Uuid
  planId     String @map("plan_id") @db.Uuid
  featureKey String @map("feature_key") // verwijst naar FEATURE_CATALOG

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("imp_plan_features")
}

// Per-org delta t.o.v. het plan (alleen afwijkingen worden opgeslagen).
model OrganizationFeature {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  featureKey  String   @map("feature_key")
  enabled     Boolean // true = bijschakelen, false = afschakelen
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("OrgFeatureUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([orgId, featureKey])
  @@map("imp_organization_features")
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  orgId             String?        @map("org_id") @db.Uuid
  email             String         @unique
  passwordHash      String         @map("password_hash")
  // Wijzigingsmoment van het wachtwoord — bindt reset-tokens aan de huidige
  // wachtwoordstaat zodat een reset-link éénmalig bruikbaar is en na een
  // wachtwoordwijziging (of hergebruik) ongeldig wordt.
  passwordChangedAt DateTime?      @map("password_changed_at")
  firstName         String         @map("first_name")
  lastName          String         @map("last_name")
  roles             Role[]         @default([])
  isActive          Boolean        @default(true) @map("is_active")
  isDeleted         Boolean        @default(false) @map("is_deleted")
  deletedAt         DateTime?      @map("deleted_at")
  emailVerifiedAt   DateTime?      @map("email_verified_at")
  initials          String?        @map("initials")
  avatarUrl         String?        @map("avatar_url")
  signatureType     SignatureType? @map("signature_type")
  signatureData     String?        @map("signature_data")
  color             String? // HEX kleurcode voor kalenderweergave, bijv. "#3B82F6"
  homeStreet        String?        @map("home_street")
  homeHouseNumber   String?        @map("home_house_number")
  homePostalCode    String?        @map("home_postal_code")
  homeCity          String?        @map("home_city")
  homeLat           Float?         @map("home_lat")
  homeLng           Float?         @map("home_lng")
  icalToken         String         @unique @default(uuid()) @map("ical_token")
  createdAt         DateTime       @default(now()) @map("created_at")

  // Standaard vrijwillige goedkeurder (persoon) — voorvult het persoon-verzoek (REQ5).
  defaultApprovalPersonId String? @map("default_approval_person_id") @db.Uuid

  // Klantportaal-contactgegevens (los van login-`email`; nooit automatisch met klanten gedeeld).
  // Worden alleen getoond bij org-modus INSPECTOR én expliciete toestemming per kanaal.
  contactPhone          String? @map("contact_phone")
  contactEmail          String? @map("contact_email")
  sharePhoneWithClients Boolean @default(false) @map("share_phone_with_clients")
  shareEmailWithClients Boolean @default(false) @map("share_email_with_clients")

  // Interne chat — beschikbaarheidsstatus (REQ1). `lastSeenAt` wordt bijgewerkt op
  // chat-activiteit via raw SQL (bewust buiten de audit-middleware om ruis te voorkomen).
  availability     Availability @default(BESCHIKBAAR)
  availabilityNote String?      @map("availability_note")
  lastSeenAt       DateTime?    @map("last_seen_at")

  organization  Organization?  @relation(fields: [orgId], references: [id])
  refreshTokens RefreshToken[]
  ownedContacts Contact[]      @relation("ContactOwner")
  contactLogs   ContactLog[]
  contactEmails ContactEmail[]

  assignedRequests     Request[]              @relation("AssignedToUser")
  createdRequests      Request[]              @relation("CreatedByUser")
  requestStatusChanges RequestStatusHistory[] @relation("StatusChangedByUser")

  createdQuotes      Quote[]                @relation("QuoteCreatedByUser")
  requestedApprovals QuoteApprovalRequest[] @relation("ApprovalRequestedByUser")
  reviewedApprovals  QuoteApprovalRequest[] @relation("ApprovalReviewedByUser")
  targetedApprovals  QuoteApprovalRequest[] @relation("ApprovalApproverUser")
  quoteQuestions     QuoteQuestion[]        @relation("QuoteQuestionUser")

  // Self-relatie: standaard vrijwillige goedkeurder.
  defaultApprovalPerson User?  @relation("UserDefaultApprover", fields: [defaultApprovalPersonId], references: [id], onDelete: SetNull)
  defaultApproverFor    User[] @relation("UserDefaultApprover")

  notifications     Notification[]
  notificationPrefs NotificationPref[]
  auditLogs         AuditLog[]
  favorites         Favorite[]

  // Per-org feature-overrides die deze gebruiker heeft gezet (PRD-09 entitlements).
  orgFeatureUpdates OrganizationFeature[] @relation("OrgFeatureUpdatedBy")

  assignedTasks       Task[]                  @relation("TaskAssignee")
  createdTasks        Task[]                  @relation("TaskCreatedBy")
  followUpAssignments QuoteTemplateFollowUp[] @relation("FollowUpAssignee")
  createdNotes        Note[]                  @relation("NoteCreatedBy")
  uploadedDocuments   Document[]              @relation("DocumentUploadedBy")

  planningInspectors        PlanningInspector[]
  planningFollowers         PlanningFollower[]
  planningHistory           PlanningHistory[]
  createdPlanningItems      PlanningItem[]             @relation("PlanningCreatedByUser")
  planningSessionInspectors PlanningSessionInspector[]
  emailTemplates            EmailTemplate[]            @relation("EmailTemplateCreatedBy")

  managedProjects  Project[]         @relation("ProjectManager")
  createdProjects  Project[]         @relation("ProjectCreatedByUser")
  projectFollowers ProjectFollower[]
  errorReports     ErrorReport[]

  // Projectfasen (PRD-12)
  createdProjectPhases  ProjectPhase[]              @relation("PhaseCreatedByUser")
  projectPhaseFollowers ProjectPhaseFollower[]
  assignedMilestones    PhaseMilestone[]            @relation("MilestoneAssignee")
  docxRevisions         QuoteTemplateDocxRevision[]
  createdWorkOrders     WorkOrder[]                 @relation("WorkOrderCreatedByUser")

  // Inspectiedomein (Fase 1)
  assignedInspectionPlans  InspectionPlan[]               @relation("InspectionPlanAssignee")
  reviewingInspectionPlans InspectionPlan[]               @relation("InspectionPlanReviewer")
  createdInspectionPlans   InspectionPlan[]               @relation("InspectionPlanCreatedBy")
  modifiedInspectionPlans  InspectionPlan[]               @relation("InspectionPlanModifiedBy")
  createdAssetNodes        AssetNode[]                    @relation("AssetNodeCreatedBy")
  visualInspections        VisualInspection[]             @relation("VisualInspectionInspector")
  measurementRecords       MeasurementRecord[]            @relation("MeasurementRecordInspector")
  createdFindings          Finding[]                      @relation("FindingCreatedBy")
  resolvedFindings         Finding[]                      @relation("FindingResolvedBy")
  uploadedInspectionPhotos Photo[]                        @relation("PhotoUploadedBy")
  inspectionSignatures     Signature[]                    @relation("SignatoryUser")
  approvedReports          Report[]                       @relation("ReportApprovedBy")
  createdReports           Report[]                       @relation("ReportCreatedBy")
  syncQueueItems           SyncQueue[]                    @relation("SyncQueueUser")
  resolvedSyncItems        SyncQueue[]                    @relation("SyncResolvedBy")
  deviceRegistrations      DeviceRegistration[]
  inspectionMessages       InspectionMessage[]            @relation("MessageUser")
  voiceUserPrompts         VoiceUserPrompt[]              @relation("VoiceUserPromptUser")
  uploadedInspectionDocx   DocumentTemplateDocxRevision[] @relation("InspectionDocxRevisionUploadedBy")

  // Interne chat (REQ1)
  createdChatThreads ChatThread[]      @relation("ChatThreadCreatedBy")
  chatParticipations ChatParticipant[] @relation("ChatParticipantUser")
  sentChatMessages   ChatMessage[]     @relation("ChatMessageSender")

  // Helpsysteem (PRD-10)
  helpArticles           HelpArticle[]          @relation("HelpArticleAuthor")
  createdSupportTickets  SupportTicket[]        @relation("SupportTicketCreatedBy")
  assignedSupportTickets SupportTicket[]        @relation("SupportTicketAssignedTo")
  supportTicketMessages  SupportTicketMessage[] @relation("SupportTicketMessageAuthor")
  supportAccessLogs      SupportAccessLog[]     @relation("SupportAccessLogPerformedBy")

  // Inspecteur-certificaten / diploma's (PRD-11)
  inspectorCertificates InspectorCertificate[] @relation("InspectorCertificates")

  // Meetmiddelen
  assignedInstruments MeasurementInstrument[] @relation("MeasurementInstrumentAssignee")
  defaultInstruments  UserDefaultInstrument[]

  // Beschikbaarheid inspecteurs (PRD-12). `employmentType` null = geen inspecteur / n.v.t.
  // Raakt de bestaande chat-presence enum `availability` (Availability) niet.
  employmentType         EmploymentType?          @map("employment_type")
  scheduleAssignments    UserScheduleAssignment[]
  availabilityExceptions AvailabilityException[]

  // AI-review van inspectierapporten (PRD-13)
  triggeredAiReviewRuns AiReviewRun[]  @relation("AiReviewRunTriggeredBy")
  checkedAiReviewItems  AiReviewItem[] @relation("AiReviewItemCheckedBy")

  @@index([orgId, isDeleted])
  @@map("imp_users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  rememberMe Boolean   @default(true) @map("remember_me")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@map("imp_refresh_tokens")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String
  role       Role
  token      String    @unique @default(uuid())
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, email])
  @@map("imp_invitations")
}

// ─── PRD-02: CRM Models ────────────────────────────────

model Contact {
  id            String      @id @default(uuid()) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  type          ContactType
  companyName   String?     @map("company_name")
  firstName     String?     @map("first_name")
  lastName      String?     @map("last_name")
  email         String?
  phone         String?
  website       String?
  vatNumber     String?     @map("vat_number")
  vatValidation Json?       @map("vat_validation")
  cocNumber     String?     @map("coc_number")

  // Leverancier / inkoop
  isSupplier             Boolean  @default(false) @map("is_supplier")
  supplierCustomerNumber String?  @map("supplier_customer_number")
  purchaseConditions     String?  @map("purchase_conditions")
  supplierRating         Boolean? @map("supplier_rating")

  notes        String?
  priceTableId String?  @map("price_table_id") @db.Uuid
  ownerId      String?  @map("owner_id") @db.Uuid
  customFields Json?    @map("custom_fields")
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization       Organization           @relation(fields: [orgId], references: [id])
  owner              User?                  @relation("ContactOwner", fields: [ownerId], references: [id])
  addresses          ContactAddress[]
  contactPersons     ContactPerson[]
  customerGroups     ContactCustomerGroup[]
  locations          Location[]
  logs               ContactLog[]
  emails             ContactEmail[]
  contactPriceTables ContactPriceTable[]
  requests           Request[]
  quotes             Quote[]
  planningItems      PlanningItem[]
  projects           Project[]

  // Inspectiedomein (Fase 1)
  inspectionPlans InspectionPlan[]
  clientAccess    ClientAccess[]
  clientRequests  ClientRequest[]

  @@index([orgId])
  @@index([ownerId])
  @@index([orgId, isSupplier])
  @@map("imp_contacts")
}

model ContactAddress {
  id           String   @id @default(uuid()) @db.Uuid
  contactId    String   @map("contact_id") @db.Uuid
  label        String
  street       String
  houseNumber  String   @map("house_number")
  postalCode   String   @map("postal_code")
  city         String
  country      String   @default("NL")
  isPrimary    Boolean  @default(false) @map("is_primary")
  isPostal     Boolean  @default(false) @map("is_postal")
  isInvoice    Boolean  @default(false) @map("is_invoice")
  customFields Json?    @map("custom_fields")
  updatedAt    DateTime @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id])

  @@index([contactId])
  @@map("imp_contact_addresses")
}

model CustomerGroup {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization           @relation(fields: [orgId], references: [id])
  contacts     ContactCustomerGroup[]

  @@map("imp_customer_groups")
}

model ContactCustomerGroup {
  contactId       String @map("contact_id") @db.Uuid
  customerGroupId String @map("customer_group_id") @db.Uuid

  contact       Contact       @relation(fields: [contactId], references: [id])
  customerGroup CustomerGroup @relation(fields: [customerGroupId], references: [id])

  @@id([contactId, customerGroupId])
  @@map("imp_contact_customer_groups")
}

model ContactPerson {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String?
  phone     String?
  roleId    String?  @map("role_id") @db.Uuid
  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contact                Contact                  @relation(fields: [contactId], references: [id])
  organization           Organization             @relation(fields: [orgId], references: [id])
  role                   ContactPersonRoleOption? @relation(fields: [roleId], references: [id])
  planningItems          PlanningItem[]
  projectPhases          ProjectPhase[]
  locationContactPersons LocationContactPerson[]

  // Inspectiedomein (Fase 1)
  installationResponsiblePlans InspectionPlan[] @relation("PlanInstallationResponsible")
  inspectionSignatures         Signature[]      @relation("SignatoryContactPerson")

  @@index([contactId])
  @@map("imp_contact_persons")
}

model Location {
  id              String   @id @default(uuid()) @db.Uuid
  contactId       String   @map("contact_id") @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  name            String
  street          String
  houseNumber     String   @map("house_number")
  postalCode      String   @map("postal_code")
  city            String
  locationTypeId  String?  @map("location_type_id") @db.Uuid
  notes           String?
  pdokData        Json?    @map("pdok_data")
  lat             Float?
  lng             Float?
  // BAG-bouwgegevens (verrijkt via PDOK BAG OGC API)
  gebruiksfunctie String?  @map("gebruiksfunctie")
  bouwjaar        Int?     @map("bouwjaar")
  oppervlakte     Float?   @map("oppervlakte")
  bagId           String?  @map("bag_id")
  customFields    Json?    @map("custom_fields")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  contact                Contact                 @relation(fields: [contactId], references: [id])
  organization           Organization            @relation(fields: [orgId], references: [id])
  locationType           LocationTypeDefinition? @relation(fields: [locationTypeId], references: [id], onDelete: SetNull)
  requests               Request[]
  quotes                 Quote[]
  planningItems          PlanningItem[]
  projects               Project[]
  projectPhases          ProjectPhase[]
  locationContactPersons LocationContactPerson[]
  inspectionPlans        InspectionPlan[]
  assetNodeRoot          AssetNode?              @relation("AssetNodeRoot") // 1:1; de wortel van de inspectie-boom voor deze locatie

  @@index([contactId])
  @@index([locationTypeId])
  @@map("imp_locations")
}

model LocationContactPerson {
  id              String   @id @default(uuid()) @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  contactPersonId String   @map("contact_person_id") @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  location      Location      @relation(fields: [locationId], references: [id])
  contactPerson ContactPerson @relation(fields: [contactPersonId], references: [id])
  organization  Organization  @relation(fields: [orgId], references: [id])

  @@unique([locationId, contactPersonId])
  @@map("imp_location_contact_persons")
}

/// Operationele log van betekenisvolle PDOK API-calls (lookup / BAG-enrich /
/// refresh). Geen audit-trail — puur queryable observability. Geen FK-relatie
/// naar User/Location zodat rijen bewaard blijven na verwijdering daarvan.
model PdokApiLog {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  locationId    String?  @map("location_id") @db.Uuid
  operation     String
  endpoint      String
  requestParams Json?    @map("request_params")
  httpStatus    Int?     @map("http_status")
  success       Boolean
  durationMs    Int?     @map("duration_ms")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@index([orgId, createdAt])
  @@index([locationId])
  @@map("imp_pdok_api_logs")
}

model ContactLog {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      LogType
  subject   String?
  body      String?
  loggedAt  DateTime @default(now()) @map("logged_at")
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([contactId])
  @@map("imp_contact_logs")
}

model ContactEmail {
  id        String    @id @default(uuid()) @db.Uuid
  contactId String    @map("contact_id") @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  resendId  String?   @map("resend_id")
  subject   String
  bodyHtml  String    @map("body_html")
  sentAt    DateTime  @default(now()) @map("sent_at")
  openedAt  DateTime? @map("opened_at")

  contact Contact @relation(fields: [contactId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([contactId])
  @@map("imp_contact_emails")
}

// ─── Lookup Tables (vervangen voorheen enums) ───────────

/// Reden waarom een aanvraag verloren ging. orgId null = globale default.
model LostReason {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  code      String
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [orgId], references: [id])
  requests     Request[]

  @@unique([orgId, code])
  @@index([orgId, isActive])
  @@map("imp_lost_reasons")
}

/// Rol van een contactpersoon. orgId null = globale default.
model ContactPersonRoleOption {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  code      String
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  organization   Organization?   @relation(fields: [orgId], references: [id])
  contactPersons ContactPerson[]

  @@unique([orgId, code])
  @@index([orgId, isActive])
  @@map("imp_contact_person_roles")
}

// ─── PRD-04: Products & Price Tables ────────────────────

model ProductGroup {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  products     Product[]

  @@map("imp_product_groups")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  productGroupId String?  @map("product_group_id") @db.Uuid
  name           String
  productCode    String?  @map("product_code")
  description    String?
  unit           String
  defaultVat     Float    @default(21) @map("default_vat")
  isActive       Boolean  @default(true) @map("is_active")
  customFields   Json?    @map("custom_fields")
  createdAt      DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [orgId], references: [id])
  productGroup    ProductGroup?    @relation(fields: [productGroupId], references: [id])
  priceTableItems PriceTableItem[]
  quoteLines      QuoteLine[]
  workOrderLines  WorkOrderLine[]

  @@unique([orgId, productCode])
  @@map("imp_products")
}

model PriceTable {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  organization       Organization        @relation(fields: [orgId], references: [id])
  items              PriceTableItem[]
  contactPriceTables ContactPriceTable[]

  @@map("imp_price_tables")
}

model PriceTableItem {
  id           String    @id @default(uuid()) @db.Uuid
  priceTableId String    @map("price_table_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  priceType    PriceType @map("price_type")
  basePrice    Decimal?  @map("base_price") @db.Decimal(12, 2)
  createdAt    DateTime  @default(now()) @map("created_at")

  priceTable PriceTable  @relation(fields: [priceTableId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  tiers      PriceTier[]

  @@index([priceTableId])
  @@index([productId])
  @@map("imp_price_table_items")
}

model PriceTier {
  id               String  @id @default(uuid()) @db.Uuid
  priceTableItemId String  @map("price_table_item_id") @db.Uuid
  fromQty          Float   @map("from_qty")
  toQty            Float?  @map("to_qty")
  price            Decimal @db.Decimal(12, 2)

  priceTableItem PriceTableItem @relation(fields: [priceTableItemId], references: [id])

  @@index([priceTableItemId])
  @@map("imp_price_tiers")
}

model ContactPriceTable {
  contactId    String @map("contact_id") @db.Uuid
  priceTableId String @map("price_table_id") @db.Uuid

  contact    Contact    @relation(fields: [contactId], references: [id])
  priceTable PriceTable @relation(fields: [priceTableId], references: [id])

  @@id([contactId, priceTableId])
  @@map("imp_contact_price_tables")
}

// ─── PRD-03: Requests (Leads & Aanvragen) ────────────────

model Request {
  id            String        @id @default(uuid()) @db.Uuid
  orgId         String        @map("org_id") @db.Uuid
  requestNumber String?       @map("request_number")
  contactId     String        @map("contact_id") @db.Uuid
  locationId    String?       @map("location_id") @db.Uuid
  assignedTo    String?       @map("assigned_to") @db.Uuid
  source        RequestSource
  status        RequestStatus @default(NIEUW)
  lostReasonId  String?       @map("lost_reason_id") @db.Uuid
  lostNote      String?       @map("lost_note")
  title         String
  description   String?
  priority      Priority      @default(NORMAL)
  customFields  Json?         @map("custom_fields")
  createdBy     String        @map("created_by") @db.Uuid
  isDeleted     Boolean       @default(false) @map("is_deleted")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  projectId String? @map("project_id") @db.Uuid

  organization  Organization           @relation(fields: [orgId], references: [id])
  contact       Contact                @relation(fields: [contactId], references: [id])
  location      Location?              @relation(fields: [locationId], references: [id])
  assignedUser  User?                  @relation("AssignedToUser", fields: [assignedTo], references: [id])
  createdByUser User                   @relation("CreatedByUser", fields: [createdBy], references: [id])
  project       Project?               @relation(fields: [projectId], references: [id])
  lostReason    LostReason?            @relation(fields: [lostReasonId], references: [id])
  statusHistory RequestStatusHistory[]
  quotes        Quote[]

  @@unique([orgId, requestNumber])
  @@index([orgId, status])
  @@index([contactId])
  @@index([assignedTo])
  @@index([projectId])
  @@map("imp_requests")
}

model RequestStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  fromStatus RequestStatus? @map("from_status")
  toStatus   RequestStatus  @map("to_status")
  changedBy  String         @map("changed_by") @db.Uuid
  changedAt  DateTime       @default(now()) @map("changed_at")
  note       String?

  request       Request @relation(fields: [requestId], references: [id])
  changedByUser User    @relation("StatusChangedByUser", fields: [changedBy], references: [id])

  @@index([requestId])
  @@map("imp_request_status_history")
}

// ─── PRD-05: Quotes (Offertes) ────────────────────────────

model QuoteTemplate {
  id                      String            @id @default(uuid()) @db.Uuid
  orgId                   String            @map("org_id") @db.Uuid
  name                    String
  description             String?           @db.Text
  templateType            QuoteTemplateType @default(BLOCKS) @map("template_type")
  coverBlocks             Json?             @map("cover_blocks")
  contentBlocks           Json?             @map("content_blocks")
  closingBlocks           Json?             @map("closing_blocks")
  docxStorageKey          String?           @map("docx_storage_key")
  docxFileName            String?           @map("docx_file_name")
  docxFileSize            Int?              @map("docx_file_size")
  defaultValidityDays     Int               @default(30) @map("default_validity_days")
  requiresApproval        Boolean           @default(false) @map("requires_approval")
  isActive                Boolean           @default(true) @map("is_active")
  sendEmailTemplateId     String?           @map("send_email_template_id") @db.Uuid
  sendEmailEnabled        Boolean           @default(true) @map("send_email_enabled")
  acceptedEmailTemplateId String?           @map("accepted_email_template_id") @db.Uuid
  acceptedEmailEnabled    Boolean           @default(true) @map("accepted_email_enabled")
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")

  organization          Organization                @relation(fields: [orgId], references: [id])
  quotes                Quote[]
  attachments           QuoteTemplateAttachment[]
  docxRevisions         QuoteTemplateDocxRevision[]
  sendEmailTemplate     EmailTemplate?              @relation("QuoteTemplateSendEmail", fields: [sendEmailTemplateId], references: [id], onDelete: SetNull)
  acceptedEmailTemplate EmailTemplate?              @relation("QuoteTemplateAcceptedEmail", fields: [acceptedEmailTemplateId], references: [id], onDelete: SetNull)
  followUpRules         QuoteTemplateFollowUp[]

  @@map("imp_quote_templates")
}

model QuoteTemplateAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  storageKey String   @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  fileSize   Int      @map("file_size")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  template QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("imp_quote_template_attachments")
}

model QuoteTemplateDocxRevision {
  id           String   @id @default(uuid()) @db.Uuid
  templateId   String   @map("template_id") @db.Uuid
  storageKey   String   @map("storage_key")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  template   QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedById], references: [id])

  @@index([templateId])
  @@map("imp_quote_template_docx_revisions")
}

model QuoteTemplateFollowUp {
  id              String               @id @default(uuid()) @db.Uuid
  templateId      String               @map("template_id") @db.Uuid
  type            FollowUpType
  delayDays       Int                  @map("delay_days")
  isActive        Boolean              @default(true) @map("is_active")
  emailTemplateId String?              @map("email_template_id") @db.Uuid
  defaultNotes    String?              @map("default_notes") @db.Text
  assigneeType    FollowUpAssigneeType @default(QUOTE_OWNER) @map("assignee_type")
  assigneeUserId  String?              @map("assignee_user_id") @db.Uuid
  sortOrder       Int                  @default(0) @map("sort_order")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  template      QuoteTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  emailTemplate EmailTemplate? @relation("FollowUpEmailTemplate", fields: [emailTemplateId], references: [id], onDelete: SetNull)
  assigneeUser  User?          @relation("FollowUpAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("imp_quote_template_follow_ups")
}

model Quote {
  id               String      @id @default(uuid()) @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  quoteNumber      String      @map("quote_number")
  templateId       String?     @map("template_id") @db.Uuid
  requestId        String?     @map("request_id") @db.Uuid
  contactId        String      @map("contact_id") @db.Uuid
  locationId       String?     @map("location_id") @db.Uuid
  status           QuoteStatus @default(CONCEPT)
  subject          String
  coverBlocks      Json?       @map("cover_blocks")
  contentBlocks    Json?       @map("content_blocks")
  closingBlocks    Json?       @map("closing_blocks")
  subtotal         Decimal     @default(0) @db.Decimal(12, 2)
  discountTotal    Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  vatTotal         Decimal     @default(0) @map("vat_total") @db.Decimal(12, 2)
  total            Decimal     @default(0) @db.Decimal(12, 2)
  validUntil       DateTime?   @map("valid_until")
  requiresApproval Boolean     @default(false) @map("requires_approval")
  internalNotes    String?     @map("internal_notes")
  customFields     Json?       @map("custom_fields")
  createdBy        String      @map("created_by") @db.Uuid

  // Send & client portal fields
  sentAt           DateTime? @map("sent_at")
  viewedAt         DateTime? @map("viewed_at")
  signedAt         DateTime? @map("signed_at")
  clientName       String?   @map("client_name")
  clientSignature  String?   @map("client_signature")
  clientIp         String?   @map("client_ip")
  clientUserAgent  String?   @map("client_user_agent")
  managerSignature String?   @map("manager_signature")
  publicToken      String?   @unique @map("public_token")

  // Generated PDF fields
  pdfStorageKey       String? @map("pdf_storage_key")
  signedPdfStorageKey String? @map("signed_pdf_storage_key")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId      String? @map("project_id") @db.Uuid
  projectPhaseId String? @map("project_phase_id") @db.Uuid

  organization     Organization           @relation(fields: [orgId], references: [id])
  template         QuoteTemplate?         @relation(fields: [templateId], references: [id])
  request          Request?               @relation(fields: [requestId], references: [id])
  contact          Contact                @relation(fields: [contactId], references: [id])
  location         Location?              @relation(fields: [locationId], references: [id])
  createdByUser    User                   @relation("QuoteCreatedByUser", fields: [createdBy], references: [id])
  project          Project?               @relation(fields: [projectId], references: [id])
  projectPhase     ProjectPhase?          @relation(fields: [projectPhaseId], references: [id])
  lines            QuoteLine[]
  approvalRequests QuoteApprovalRequest[]
  questions        QuoteQuestion[]
  attachments      QuoteAttachment[]

  @@unique([orgId, quoteNumber])
  @@index([orgId, status])
  @@index([contactId])
  @@index([requestId])
  @@index([projectId])
  @@index([orgId, createdBy])
  @@map("imp_quotes")
}

model QuoteQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  quoteId      String   @map("quote_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  message      String
  isFromClient Boolean  @default(false) @map("is_from_client")
  createdAt    DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user  User? @relation("QuoteQuestionUser", fields: [userId], references: [id])

  @@index([quoteId])
  @@map("imp_quote_questions")
}

model QuoteAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  quoteId    String   @map("quote_id") @db.Uuid
  storageKey String   @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  fileSize   Int      @map("file_size")
  isStandard Boolean  @default(false) @map("is_standard")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("imp_quote_attachments")
}

model QuoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  description String
  quantity    Float
  unit        String
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  vatRate     Float   @default(21) @map("vat_rate")
  discountPct Float   @default(0) @map("discount_pct")
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  sortOrder   Int     @default(0) @map("sort_order")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("imp_quote_lines")
}

model QuoteApprovalRequest {
  id          String         @id @default(uuid()) @db.Uuid
  quoteId     String         @map("quote_id") @db.Uuid
  requestedBy String         @map("requested_by") @db.Uuid
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  status      ApprovalStatus @default(PENDING)
  note        String?
  requestedAt DateTime       @default(now()) @map("requested_at")
  reviewedAt  DateTime?      @map("reviewed_at")

  // Gericht goedkeuringsverzoek (REQ5).
  kind           ApprovalKind @default(THRESHOLD)
  // Doelrol: voor THRESHOLD de org-vereiste rol; voor VOLUNTARY_TEAM de rol/team van de aanvrager.
  approverRole   Role?        @map("approver_role")
  // Doelpersoon: alleen voor VOLUNTARY_PERSON.
  approverUserId String?      @map("approver_user_id") @db.Uuid

  quote           Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestedByUser User  @relation("ApprovalRequestedByUser", fields: [requestedBy], references: [id])
  reviewedByUser  User? @relation("ApprovalReviewedByUser", fields: [reviewedBy], references: [id])
  approverUser    User? @relation("ApprovalApproverUser", fields: [approverUserId], references: [id])

  @@index([quoteId])
  @@map("imp_quote_approval_requests")
}

// ─── PRD-06: Notifications ────────────────────────────────

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  orgId      String?          @map("org_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  body       String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id") @db.Uuid
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  organization Organization? @relation(fields: [orgId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("imp_notifications")
}

model NotificationPref {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  notificationType NotificationType @map("notification_type")
  channelInApp     Boolean          @default(true) @map("channel_in_app")
  channelEmail     Boolean          @default(true) @map("channel_email")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, notificationType])
  @@map("imp_notification_prefs")
}

model NotificationGroupPref {
  id               String           @id @default(uuid()) @db.Uuid
  orgId            String           @map("org_id") @db.Uuid
  role             Role
  notificationType NotificationType @map("notification_type")
  channelInApp     Boolean          @default(true) @map("channel_in_app")
  channelEmail     Boolean          @default(true) @map("channel_email")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, role, notificationType])
  @@map("imp_notification_group_prefs")
}

// ─── Audit Trail ─────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  orgId      String?     @map("org_id") @db.Uuid
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  action     AuditAction
  changes    Json?
  snapshot   Json?
  userId     String      @map("user_id") @db.Uuid
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([orgId, createdAt])
  @@index([userId])
  @@map("imp_audit_logs")
}

// ─── Task Management ─────────────────────────────────────

model Task {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus     @default(TE_DOEN)
  taskType    TaskType       @default(TO_DO) @map("task_type")
  entityType  TaskEntityType @map("entity_type")
  entityId    String         @map("entity_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  deadline    DateTime?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([orgId, status])
  @@index([assigneeId])
  @@index([entityType, entityId])
  @@index([orgId, deadline])
  @@index([createdById])
  @@map("imp_tasks")
}

// ─── Document Management ────────────────────────────────

model Document {
  id                 String             @id @default(uuid()) @db.Uuid
  orgId              String             @map("org_id") @db.Uuid
  entityType         DocumentEntityType @map("entity_type")
  entityId           String             @map("entity_id") @db.Uuid
  fileName           String             @map("file_name")
  originalName       String             @map("original_name")
  mimeType           String             @map("mime_type")
  size               Int
  storageKey         String             @map("storage_key")
  description        String?
  uploadedById       String             @map("uploaded_by_id") @db.Uuid
  isDeleted          Boolean            @default(false) @map("is_deleted")
  isSharedWithClient Boolean            @default(false) @map("is_shared_with_client")
  createdAt          DateTime           @default(now()) @map("created_at")

  organization Organization            @relation(fields: [orgId], references: [id])
  uploadedBy   User                    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  tags         DocumentTagAssignment[]

  @@index([orgId, entityType, entityId])
  @@index([uploadedById])
  @@map("imp_documents")
}

// ─── Document Tags ──────────────────────────────────────

model DocumentTag {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  color     String
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization            @relation(fields: [orgId], references: [id])
  documents    DocumentTagAssignment[]

  @@unique([orgId, name])
  @@map("imp_document_tags")
}

model DocumentTagAssignment {
  documentId    String   @map("document_id") @db.Uuid
  documentTagId String   @map("document_tag_id") @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentTag DocumentTag @relation(fields: [documentTagId], references: [id], onDelete: Cascade)

  @@id([documentId, documentTagId])
  @@index([orgId])
  @@index([documentTagId])
  @@map("imp_document_tag_assignments")
}

// ─── PRD-07: Planning & Afspraken ───────────────────────

model PlanningItem {
  id              String         @id @default(uuid()) @db.Uuid
  orgId           String         @map("org_id") @db.Uuid
  quoteId         String?        @map("quote_id") @db.Uuid
  contactId       String         @map("contact_id") @db.Uuid
  contactPersonId String?        @map("contact_person_id") @db.Uuid
  locationId      String?        @map("location_id") @db.Uuid
  productId       String?        @map("product_id") @db.Uuid
  productName     String         @map("product_name")
  status          PlanningStatus @default(NOG_TE_PLANNEN)
  isCancelled     Boolean        @default(false) @map("is_cancelled")
  cancelledAt     DateTime?      @map("cancelled_at")
  cancelledBy     String?        @map("cancelled_by") @db.Uuid
  cancelReason    String?        @map("cancel_reason")

  scheduledDate DateTime? @map("scheduled_date")
  durationHours Float?    @map("duration_hours")
  endTime       DateTime? @map("end_time")

  isMultiDay   Boolean @default(false) @map("is_multi_day")
  sessionCount Int?    @map("session_count")

  labels        String[] @default([])
  internalNotes String?  @map("internal_notes")
  publicToken   String   @unique @default(uuid()) @map("public_token")

  // Stored as plain strings (not Prisma relations) to avoid self-referential complexity
  replacedById String?   @map("replaced_by_id") @db.Uuid
  replacesId   String?   @map("replaces_id") @db.Uuid
  originalDate DateTime? @map("original_date")

  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projectId      String? @map("project_id") @db.Uuid
  projectPhaseId String? @map("project_phase_id") @db.Uuid

  organization       Organization        @relation(fields: [orgId], references: [id])
  contact            Contact             @relation(fields: [contactId], references: [id])
  contactPerson      ContactPerson?      @relation(fields: [contactPersonId], references: [id])
  location           Location?           @relation(fields: [locationId], references: [id])
  createdByUser      User                @relation("PlanningCreatedByUser", fields: [createdBy], references: [id])
  project            Project?            @relation(fields: [projectId], references: [id])
  projectPhase       ProjectPhase?       @relation(fields: [projectPhaseId], references: [id])
  inspectors         PlanningInspector[]
  history            PlanningHistory[]
  rescheduleRequests RescheduleRequest[]
  followers          PlanningFollower[]
  sessions           PlanningSession[]
  workOrders         WorkOrder[]

  @@index([orgId, status])
  @@index([orgId, scheduledDate])
  @@index([contactId])
  @@index([quoteId])
  @@index([projectId])
  @@map("imp_planning_items")
}

model PlanningInspector {
  id               String           @id @default(uuid()) @db.Uuid
  planningItemId   String           @map("planning_item_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  isPrimary        Boolean          @default(false) @map("is_primary")
  acceptanceStatus AcceptanceStatus @default(PENDING) @map("acceptance_status")
  acceptedAt       DateTime?        @map("accepted_at")
  rejectedAt       DateTime?        @map("rejected_at")
  rejectionNote    String?          @map("rejection_note")

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([planningItemId, userId])
  @@map("imp_planning_inspectors")
}

model PlanningHistory {
  id             String   @id @default(uuid()) @db.Uuid
  planningItemId String   @map("planning_item_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  description    String
  oldValue       String?  @map("old_value")
  newValue       String?  @map("new_value")
  createdAt      DateTime @default(now()) @map("created_at")

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([planningItemId])
  @@map("imp_planning_history")
}

model RescheduleRequest {
  id             String           @id @default(uuid()) @db.Uuid
  planningItemId String           @map("planning_item_id") @db.Uuid
  requestedBy    String?          @map("requested_by") @db.Uuid
  clientName     String?          @map("client_name")
  preferredDate  DateTime         @map("preferred_date")
  reason         String
  status         RescheduleStatus @default(PENDING)
  processedBy    String?          @map("processed_by") @db.Uuid
  processedAt    DateTime?        @map("processed_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)

  @@index([planningItemId])
  @@map("imp_reschedule_requests")
}

model PlanningFollower {
  id             String   @id @default(uuid()) @db.Uuid
  planningItemId String   @map("planning_item_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  email          String?
  name           String?
  createdAt      DateTime @default(now()) @map("created_at")

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([planningItemId])
  @@map("imp_planning_followers")
}

model PlanningSession {
  id             String        @id @default(uuid()) @db.Uuid
  planningItemId String        @map("planning_item_id") @db.Uuid
  sessionNumber  Int           @map("session_number")
  scheduledDate  DateTime?     @map("scheduled_date")
  durationHours  Float?        @map("duration_hours")
  status         SessionStatus @default(NOG_TE_PLANNEN)
  notes          String?
  isDefinitief   Boolean       @default(false) @map("is_definitief")
  confirmedAt    DateTime?     @map("confirmed_at")
  confirmedBy    String?       @map("confirmed_by") @db.Uuid
  // Reschedule tracking (same pattern as PlanningItem — stored as plain strings)
  replacedById   String?       @map("replaced_by_id") @db.Uuid
  replacesId     String?       @map("replaces_id") @db.Uuid
  originalDate   DateTime?     @map("original_date")
  isCancelled    Boolean       @default(false) @map("is_cancelled")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  planningItem      PlanningItem               @relation(fields: [planningItemId], references: [id], onDelete: Cascade)
  sessionInspectors PlanningSessionInspector[]

  @@index([planningItemId, sessionNumber])
  @@index([planningItemId, scheduledDate])
  @@map("imp_planning_sessions")
}

model PlanningSessionInspector {
  id               String           @id @default(uuid()) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  isPrimary        Boolean          @default(false) @map("is_primary")
  acceptanceStatus AcceptanceStatus @default(PENDING) @map("acceptance_status")
  acceptedAt       DateTime?        @map("accepted_at")
  rejectedAt       DateTime?        @map("rejected_at")
  rejectionNote    String?          @map("rejection_note")

  session PlanningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@map("imp_planning_session_inspectors")
}

// ─── Projects (Dossiers) ────────────────────────────────

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  projectNumber    String        @map("project_number")
  title            String
  description      String?
  status           ProjectStatus @default(ACTIEF)
  contactId        String        @map("contact_id") @db.Uuid
  locationId       String?       @map("location_id") @db.Uuid
  projectManagerId String        @map("project_manager_id") @db.Uuid
  startDate        DateTime      @default(now()) @map("start_date")
  expectedEndDate  DateTime?     @map("expected_end_date")
  endDate          DateTime?     @map("end_date")
  isDeleted        Boolean       @default(false) @map("is_deleted")
  deletedAt        DateTime?     @map("deleted_at")
  createdBy        String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [orgId], references: [id])
  contact        Contact           @relation(fields: [contactId], references: [id])
  location       Location?         @relation(fields: [locationId], references: [id])
  projectManager User              @relation("ProjectManager", fields: [projectManagerId], references: [id])
  createdByUser  User              @relation("ProjectCreatedByUser", fields: [createdBy], references: [id])
  followers      ProjectFollower[]
  requests       Request[]
  quotes         Quote[]
  planningItems  PlanningItem[]
  phases         ProjectPhase[]

  // Inspectiedomein (Fase 1)
  inspectionPlans InspectionPlan[]

  @@unique([orgId, projectNumber])
  @@index([orgId, status])
  @@index([contactId])
  @@index([projectManagerId])
  @@map("imp_projects")
}

model ProjectFollower {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  email            String?
  name             String?
  canViewGeneral   Boolean  @default(true) @map("can_view_general")
  canViewRequests  Boolean  @default(false) @map("can_view_requests")
  canViewQuotes    Boolean  @default(true) @map("can_view_quotes")
  canViewPlanning  Boolean  @default(true) @map("can_view_planning")
  canViewDocuments Boolean  @default(false) @map("can_view_documents")
  createdAt        DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@map("imp_project_followers")
}

// ─── PRD-12: Projectfasen (deelprojecten binnen een project) ───

enum PhaseStatus {
  NIET_GESTART
  ACTIEF
  ON_HOLD
  AFGEROND
  GEANNULEERD
}

enum MilestoneStatus {
  OPEN
  BEHAALD
  VERVALLEN
}

model ProjectPhase {
  id          String      @id @default(uuid()) @db.Uuid
  orgId       String      @map("org_id") @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  name        String
  description String?
  status      PhaseStatus @default(NIET_GESTART)
  sortOrder   Int         @default(0) @map("sort_order")

  // Eigen context per fase (alles optioneel — erft anders visueel van het project)
  locationId      String?   @map("location_id") @db.Uuid // CRM-Location
  contactPersonId String?   @map("contact_person_id") @db.Uuid // ContactPerson van het projectcontact
  startDate       DateTime? @map("start_date") @db.Date
  expectedEndDate DateTime? @map("expected_end_date") @db.Date
  completedAt     DateTime? @map("completed_at")

  // Haak voor deelfacturatie (PRD-08); nu alleen registratie
  budgetAmount Decimal? @map("budget_amount") @db.Decimal(12, 2)

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at")
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization  Organization           @relation(fields: [orgId], references: [id])
  project       Project                @relation(fields: [projectId], references: [id])
  location      Location?              @relation(fields: [locationId], references: [id])
  contactPerson ContactPerson?         @relation(fields: [contactPersonId], references: [id])
  createdByUser User                   @relation("PhaseCreatedByUser", fields: [createdBy], references: [id])
  followers     ProjectPhaseFollower[]
  milestones    PhaseMilestone[]

  inspectionPlans InspectionPlan[]
  planningItems   PlanningItem[]
  workOrders      WorkOrder[]
  quotes          Quote[]

  @@index([orgId, projectId, sortOrder])
  @@index([projectId, status])
  @@map("imp_project_phases")
}

model ProjectPhaseFollower {
  id               String   @id @default(uuid()) @db.Uuid
  phaseId          String   @map("phase_id") @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  email            String?
  name             String?
  canViewGeneral   Boolean  @default(true) @map("can_view_general")
  canViewRequests  Boolean  @default(false) @map("can_view_requests")
  canViewQuotes    Boolean  @default(true) @map("can_view_quotes")
  canViewPlanning  Boolean  @default(true) @map("can_view_planning")
  canViewDocuments Boolean  @default(false) @map("can_view_documents")
  createdAt        DateTime @default(now()) @map("created_at")

  phase ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  user  User?        @relation(fields: [userId], references: [id])

  @@index([phaseId])
  @@map("imp_project_phase_followers")
}

model PhaseMilestone {
  id                 String          @id @default(uuid()) @db.Uuid
  orgId              String          @map("org_id") @db.Uuid
  phaseId            String          @map("phase_id") @db.Uuid
  title              String
  description        String?
  dueDate            DateTime        @map("due_date") @db.Date
  status             MilestoneStatus @default(OPEN)
  completedAt        DateTime?       @map("completed_at")
  assigneeId         String?         @map("assignee_id") @db.Uuid
  reminderDaysBefore Int             @default(7) @map("reminder_days_before")

  // Dedupe-patroon identiek aan MeasurementInstrumentsScheduler
  lastReminderStage String?   @map("last_reminder_stage") // 'upcoming' | 'overdue'
  lastReminderAt    DateTime? @map("last_reminder_at")

  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  phase        ProjectPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("MilestoneAssignee", fields: [assigneeId], references: [id])

  @@index([phaseId, dueDate])
  @@index([orgId, status, dueDate])
  @@map("imp_project_phase_milestones")
}

// ─── Custom Fields ──────────────────────────────────────

model CustomFieldDefinition {
  id         String                @id @default(uuid()) @db.Uuid
  orgId      String                @map("org_id") @db.Uuid
  entityType CustomFieldEntityType @map("entity_type")
  fieldName  String                @map("field_name")
  label      String
  fieldType  CustomFieldType       @map("field_type")
  options    Json?
  isRequired Boolean               @default(false) @map("is_required")
  sortOrder  Int                   @default(0) @map("sort_order")
  isDeleted  Boolean               @default(false) @map("is_deleted")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, entityType, fieldName])
  @@index([orgId, entityType])
  @@map("imp_custom_field_definitions")
}

// ─── Configurable record numbering (per org, per model) ──

model NumberingScheme {
  id               String         @id @default(uuid()) @db.Uuid
  orgId            String         @map("org_id") @db.Uuid
  model            NumberingModel
  prefix           String         @default("")
  suffix           String         @default("")
  mode             NumberingMode  @default(SEQUENTIAL)
  start            Int            @default(1)
  interval         Int            @default(1)
  digits           Int            @default(4)
  resetPolicy      NumberingReset @default(CONTINUOUS) @map("reset_policy")
  allowManualEntry Boolean        @default(false) @map("allow_manual_entry")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [orgId], references: [id])
  counters     NumberingCounter[]

  @@unique([orgId, model])
  @@map("imp_numbering_schemes")
}

// Atomic per-period counter — incremented in a single ON CONFLICT statement so
// number generation never relies on a racy max+1 scan. `value` = last issued value.
model NumberingCounter {
  id        String   @id @default(uuid()) @db.Uuid
  schemeId  String   @map("scheme_id") @db.Uuid
  periodKey String   @map("period_key")
  value     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  scheme NumberingScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, periodKey])
  @@map("imp_numbering_counters")
}

// ─── Email Templates ────────────────────────────────────

model EmailTemplate {
  id        String            @id @default(uuid()) @db.Uuid
  orgId     String            @map("org_id") @db.Uuid
  type      EmailTemplateType
