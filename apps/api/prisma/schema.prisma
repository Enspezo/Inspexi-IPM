generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPERUSER
  ORG_ADMIN
  MANAGER
  BACKOFFICE
  WERKVOORBEREIDER
  INSPECTEUR
}

enum ContactType {
  COMPANY
  INDIVIDUAL
}

enum LogType {
  EMAIL
  PHONE
  MEETING
  NOTE
}

enum PriceType {
  FIXED
  TIERED
}

// ─── PRD-01: Foundation Models ───────────────────────────

model Organization {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  logoUrl             String?  @map("logo_url")
  primaryColor        String?  @map("primary_color")
  defaultVat          Float    @default(21) @map("default_vat")
  defaultValidityDays Int      @default(30) @map("default_validity_days")
  createdAt           DateTime @default(now()) @map("created_at")

  users       User[]
  invitations Invitation[]
  contacts    Contact[]
  locations   Location[]
  products    Product[]
  priceTables PriceTable[]

  @@map("imp_organizations")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String?   @map("org_id") @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  role            Role
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization  Organization?  @relation(fields: [orgId], references: [id])
  refreshTokens RefreshToken[]
  contactLogs   ContactLog[]
  contactEmails ContactEmail[]

  @@map("imp_users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@map("imp_refresh_tokens")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String
  role       Role
  token      String    @unique @default(uuid())
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("imp_invitations")
}

// ─── PRD-02: CRM Models ────────────────────────────────

model Contact {
  id           String      @id @default(uuid()) @db.Uuid
  orgId        String      @map("org_id") @db.Uuid
  type         ContactType
  companyName  String?     @map("company_name")
  firstName    String?     @map("first_name")
  lastName     String?     @map("last_name")
  email        String?
  phone        String?
  website      String?
  vatNumber    String?     @map("vat_number")
  cocNumber    String?     @map("coc_number")
  notes        String?
  priceTableId String?     @map("price_table_id") @db.Uuid
  isDeleted    Boolean     @default(false) @map("is_deleted")
  createdAt    DateTime    @default(now()) @map("created_at")

  organization       Organization        @relation(fields: [orgId], references: [id])
  addresses          ContactAddress[]
  locations          Location[]
  logs               ContactLog[]
  emails             ContactEmail[]
  contactPriceTables ContactPriceTable[]

  @@map("imp_contacts")
}

model ContactAddress {
  id          String  @id @default(uuid()) @db.Uuid
  contactId   String  @map("contact_id") @db.Uuid
  label       String
  street      String
  houseNumber String  @map("house_number")
  postalCode  String  @map("postal_code")
  city        String
  country     String  @default("NL")
  isPrimary   Boolean @default(false) @map("is_primary")

  contact Contact @relation(fields: [contactId], references: [id])

  @@map("imp_contact_addresses")
}

model Location {
  id          String   @id @default(uuid()) @db.Uuid
  contactId   String   @map("contact_id") @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  street      String
  houseNumber String   @map("house_number")
  postalCode  String   @map("postal_code")
  city        String
  objectType  String?  @map("object_type")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  contact      Contact      @relation(fields: [contactId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])

  @@map("imp_locations")
}

model ContactLog {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      LogType
  subject   String?
  body      String?
  loggedAt  DateTime @default(now()) @map("logged_at")
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("imp_contact_logs")
}

model ContactEmail {
  id       String    @id @default(uuid()) @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  orgId    String    @map("org_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  resendId String?   @map("resend_id")
  subject  String
  bodyHtml String    @map("body_html")
  sentAt   DateTime  @default(now()) @map("sent_at")
  openedAt DateTime? @map("opened_at")

  contact Contact @relation(fields: [contactId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("imp_contact_emails")
}

// ─── PRD-04: Products & Price Tables ────────────────────

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  description String?
  unit        String
  defaultVat  Float    @default(21) @map("default_vat")
  category    String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  organization    Organization     @relation(fields: [orgId], references: [id])
  priceTableItems PriceTableItem[]

  @@map("imp_products")
}

model PriceTable {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  organization       Organization        @relation(fields: [orgId], references: [id])
  items              PriceTableItem[]
  contactPriceTables ContactPriceTable[]

  @@map("imp_price_tables")
}

model PriceTableItem {
  id           String    @id @default(uuid()) @db.Uuid
  priceTableId String    @map("price_table_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  priceType    PriceType @map("price_type")
  basePrice    Float?    @map("base_price")
  createdAt    DateTime  @default(now()) @map("created_at")

  priceTable PriceTable @relation(fields: [priceTableId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  tiers      PriceTier[]

  @@map("imp_price_table_items")
}

model PriceTier {
  id               String @id @default(uuid()) @db.Uuid
  priceTableItemId String @map("price_table_item_id") @db.Uuid
  fromQty          Float  @map("from_qty")
  toQty            Float? @map("to_qty")
  price            Float

  priceTableItem PriceTableItem @relation(fields: [priceTableItemId], references: [id])

  @@map("imp_price_tiers")
}

model ContactPriceTable {
  contactId    String @map("contact_id") @db.Uuid
  priceTableId String @map("price_table_id") @db.Uuid

  contact    Contact    @relation(fields: [contactId], references: [id])
  priceTable PriceTable @relation(fields: [priceTableId], references: [id])

  @@id([contactId, priceTableId])
  @@map("imp_contact_price_tables")
}
