  inspectionPlan  InspectionPlan               @relation(fields: [inspectionPlanId], references: [id], onDelete: Cascade)
  locationNode    AssetNode                    @relation("NodeStandalone", fields: [locationNodeId], references: [id])
  linkedAssetNode AssetNode?                   @relation("LinkedAsset", fields: [linkedAssetNodeId], references: [id])
  values          StandaloneMeasurementValue[]
  markers         LocationImageMarker[]

  @@index([orgId])
  @@index([orgId, updatedAt])
  @@index([inspectionPlanId])
  @@index([locationNodeId])
  @@index([linkedAssetNodeId])
  @@map("imp_standalone_measurements")
}

model StandaloneMeasurementValue {
