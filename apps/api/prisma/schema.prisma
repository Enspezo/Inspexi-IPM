  addressStreet      String?  @map("address_street")
  addressHouseNumber String?  @map("address_house_number")
  addressPostalCode  String?  @map("address_postal_code")
  addressCity        String?  @map("address_city")
  gpsLatitude        Decimal? @map("gps_latitude") @db.Decimal(10, 8)
  gpsLongitude       Decimal? @map("gps_longitude") @db.Decimal(11, 8)

  plannedDate          DateTime? @map("planned_date") @db.Date
  plannedDurationHours Decimal?  @map("planned_duration_hours") @db.Decimal(4, 1)
  deadline             DateTime? @db.Date

  assignedTo String? @map("assigned_to") @db.Uuid
  reviewerId String? @map("reviewer_id") @db.Uuid

  statusCode  String    @default("draft") @map("status") // → imp_plan_status_types.code
  startedAt   DateTime? @map("started_at")
  submittedAt DateTime? @map("submitted_at")
  reviewedAt  DateTime? @map("reviewed_at")
  approvedAt  DateTime? @map("approved_at")
  completedAt DateTime? @map("completed_at")

  installationResponsibleId String? @map("installation_responsible_id") @db.Uuid // → ContactPerson

  notes         String?
  internalNotes String? @map("internal_notes")
  metadata      Json    @default("{}")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  syncedAt       DateTime? @map("synced_at")
  createdBy      String?   @map("created_by") @db.Uuid
  lastModifiedBy String?   @map("last_modified_by") @db.Uuid
  deviceId       String?   @map("device_id")
  deletedAt      DateTime? @map("deleted_at")

  organization            Organization        @relation(fields: [orgId], references: [id])
  contact                 Contact             @relation(fields: [contactId], references: [id])
  project                 Project?            @relation(fields: [projectId], references: [id])
  projectPhase            ProjectPhase?       @relation(fields: [projectPhaseId], references: [id])
  location                Location?           @relation(fields: [locationId], references: [id])
  assignedUser            User?               @relation("InspectionPlanAssignee", fields: [assignedTo], references: [id])
