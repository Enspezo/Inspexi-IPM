// ─── Inspecteur-certificaten / diploma's (PRD-11) ───
// Rol-specifieke datalaag voor INSPECTEUR-gebruikers: diploma's en certificaten
// met een optioneel privé-document. Bewust een op zichzelf staande module (géén
// generiek polymorf framework) en LOS van het generieke /documents DMS — het
// certificaatbestand mag nooit via /documents zichtbaar of downloadbaar zijn.

model InspectorCertificate {
  id           String    @id @default(uuid()) @db.Uuid
  orgId        String    @map("org_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  type         String // Soort certificaat/diploma (vrije tekst, autocomplete)
  number       String? // Certificaatnummer (optioneel)
  issueDate    DateTime  @map("issue_date") @db.Date // Datum van afgifte
  validUntil   DateTime? @map("valid_until") @db.Date // Geldig tot (optioneel)
  issuer       String // Uitgevende instantie (vrije tekst, autocomplete)
  // Privé-bestand (optioneel) — opgeslagen via de StorageProvider.
  storageKey   String?   @map("storage_key")
  fileName     String?   @map("file_name")
  originalName String?   @map("original_name")
  mimeType     String?   @map("mime_type")
  size         Int?
  isDeleted    Boolean   @default(false) @map("is_deleted")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation("InspectorCertificates", fields: [userId], references: [id])

  @@index([orgId, userId])
  @@index([userId])
  @@map("imp_inspector_certificates")
}

// ─── Meetmiddelen (measurement instruments) + Kalibraties ────────────────────

enum MeasurementInstrumentStatus {
  ACTIEF
  BUITEN_GEBRUIK
  AFGEKEURD
}

/// Meetmiddel — apparatuur van een organisatie, optioneel toegewezen aan één inspecteur.
/// `assignedToUserId == null` ⇒ "op voorraad". Verloopdatum is afgeleid: laatste
/// kalibratiedatum + interval (gedenormaliseerd gecachet in lastCalibrationDate/nextCalibrationDue).
model MeasurementInstrument {
  id                        String                      @id @default(uuid()) @db.Uuid
  orgId                     String                      @map("org_id") @db.Uuid
  code                      String // Uniek nummer (uniek per org)
  brand                     String // Merk
  type                      String // Type
  serialNumber              String?                     @map("serial_number") // Serienummer (optioneel)
  calibrationIntervalMonths Int                         @map("calibration_interval_months") // Kalibratie-interval in maanden
  status                    MeasurementInstrumentStatus @default(ACTIEF)
  assignedToUserId          String?                     @map("assigned_to_user_id") @db.Uuid // Huidige houder; null = op voorraad
  notes                     String?
  // Gedenormaliseerde cache (herberekend bij elke kalibratie-mutatie)
  lastCalibrationDate       DateTime?                   @map("last_calibration_date")
  nextCalibrationDue        DateTime?                   @map("next_calibration_due")
  // Dedupe voor verloop-notificaties (stage: "30d" | "expired")
  lastExpiryNotifiedStage   String?                     @map("last_expiry_notified_stage")
  lastExpiryNotifiedAt      DateTime?                   @map("last_expiry_notified_at")
  isDeleted                 Boolean                     @default(false) @map("is_deleted")
  createdById               String?                     @map("created_by_id") @db.Uuid
  createdAt                 DateTime                    @default(now()) @map("created_at")
  updatedAt                 DateTime                    @updatedAt @map("updated_at")

  organization       Organization                      @relation(fields: [orgId], references: [id])
  assignedTo         User?                             @relation("MeasurementInstrumentAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  calibrations       Calibration[]
  userDefaults       UserDefaultInstrument[]
  inspectionDefaults InspectionPlanDefaultInstrument[]

  @@unique([orgId, code])
  @@index([orgId, nextCalibrationDue])
  @@index([orgId, assignedToUserId])
  @@index([orgId, updatedAt])
  @@map("imp_measurement_instruments")
}

/// Kalibratie — één kalibratie-gebeurtenis van een meetmiddel, met optioneel
/// kalibratiecertificaat (embedded storage-metadata zoals InspectorCertificate).
model Calibration {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  instrumentId      String   @map("instrument_id") @db.Uuid
  calibrationDate   DateTime @map("calibration_date")
  performedBy       String   @map("performed_by") // Uitvoerende instantie
  certificateNumber String?  @map("certificate_number")
  notes             String?
  // Kalibratiecertificaat (optioneel) — opgeslagen via de StorageProvider.
  storageKey        String?  @map("storage_key")
  fileName          String?  @map("file_name")
  originalName      String?  @map("original_name")
  mimeType          String?  @map("mime_type")
  size              Int?
  isDeleted         Boolean  @default(false) @map("is_deleted")
  createdById       String?  @map("created_by_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  organization Organization          @relation(fields: [orgId], references: [id])
  instrument   MeasurementInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([orgId, instrumentId])
  @@map("imp_measurement_instrument_calibrations")
}

/// Voorkeur niveau 1 — globale set favoriete meetmiddelen per inspecteur.
model UserDefaultInstrument {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  instrumentId String   @map("instrument_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  organization Organization          @relation(fields: [orgId], references: [id])
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument   MeasurementInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([userId, instrumentId])
  @@index([orgId])
  @@index([instrumentId])
  @@map("imp_user_default_instruments")
}

/// Voorkeur niveau 2 — override-set meetmiddelen per inspectie.
model InspectionPlanDefaultInstrument {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  inspectionPlanId String   @map("inspection_plan_id") @db.Uuid
  instrumentId     String   @map("instrument_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  organization   Organization          @relation(fields: [orgId], references: [id])
  inspectionPlan InspectionPlan        @relation(fields: [inspectionPlanId], references: [id], onDelete: Cascade)
  instrument     MeasurementInstrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([inspectionPlanId, instrumentId])
  @@index([orgId])
  @@index([instrumentId])
  @@map("imp_inspection_plan_default_instruments")
}

// ─── Beschikbaarheid inspecteurs (PRD-12) ────────────────────────────────────
// Weekschema-template als baseline (dienstverband) + uitzonderingen (overrides)
// er bovenop. Losstaand van de bestaande chat-presence enum `Availability`.

/// Dienstvorm per inspecteur. `DIENSTVERBAND` = standaard beschikbaar volgens
/// weekschema; `FREELANCE` = standaard niet beschikbaar (opgeven via excepties).
enum EmploymentType {
  DIENSTVERBAND
  FREELANCE
}

/// Type uitzondering: voegt beschikbaarheid toe of blokkeert die.
enum AvailabilityExceptionType {
  BESCHIKBAAR // voegt beschikbaarheid toe (freelance-patroon of extra dag dienstverband)
  GEBLOKKEERD // blokkeert beschikbaarheid (verlof, afwezigheid) — wint altijd
}

/// Herbruikbaar weekschema per organisatie met tijdsloten per weekdag.
model AvailabilityTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String // "Standaard", "Sjaak Parttime"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization               @relation(fields: [orgId], references: [id])
  slots        AvailabilityTemplateSlot[]
  assignments  UserScheduleAssignment[]

  @@unique([orgId, name])
  @@index([orgId, isDeleted])
  @@map("imp_availability_templates")
}

/// Eén tijdslot binnen een template-weekdag (minuten vanaf middernacht).
model AvailabilityTemplateSlot {
  id          String @id @default(uuid()) @db.Uuid
  templateId  String @map("template_id") @db.Uuid
  weekday     Int // ISO-8601: 1 = maandag ... 7 = zondag
  startMinute Int    @map("start_minute") // 480 = 08:00
  endMinute   Int    @map("end_minute") // 1050 = 17:30

  template AvailabilityTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("imp_availability_template_slots")
}

/// Koppeling inspecteur → template met ingangsdatum, zodat schemawissels
/// historisch kloppen (`validUntil` wordt gezet bij het toewijzen van een opvolger).
model UserScheduleAssignment {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  templateId  String    @map("template_id") @db.Uuid
  validFrom   DateTime  @map("valid_from") @db.Date // date-only (00:00 lokale tijd)
  validUntil  DateTime? @map("valid_until") @db.Date // null = doorlopend
  createdById String    @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization         @relation(fields: [orgId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
  template     AvailabilityTemplate @relation(fields: [templateId], references: [id])

  @@index([orgId, userId, validFrom])
  @@map("imp_user_schedule_assignments")
}

/// Eenmalige of wekelijks herhalende periode die beschikbaarheid toevoegt of blokkeert.
/// Óf eenmalig (startsAt/endsAt) óf herhalend (RRULE-subset FREQ=WEEKLY), nooit beide.
model AvailabilityException {
  id     String                    @id @default(uuid()) @db.Uuid
  orgId  String                    @map("org_id") @db.Uuid
  userId String                    @map("user_id") @db.Uuid
  type   AvailabilityExceptionType

  // Eenmalig (isRecurring = false): absolute periode.
  startsAt DateTime? @map("starts_at")
  endsAt   DateTime? @map("ends_at")
  allDay   Boolean   @default(false) @map("all_day")

  // Herhalend (isRecurring = true): RRULE-subset FREQ=WEEKLY.
  isRecurring    Boolean   @default(false) @map("is_recurring")
  weekdays       Int[]     @default([]) // ISO 1..7
  startMinute    Int?      @map("start_minute") // 60 = 01:00
  endMinute      Int?      @map("end_minute") // 300 = 05:00
  intervalWeeks  Int       @default(1) @map("interval_weeks") // 1 = wekelijks, 2 = tweewekelijks
  recurStartDate DateTime? @map("recur_start_date") @db.Date
  recurEndDate   DateTime? @map("recur_end_date") @db.Date

  reason      String?
  createdById String   @map("created_by_id") @db.Uuid // inspecteur zelf of manager
  isDeleted   Boolean  @default(false) @map("is_deleted")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([orgId, userId, isDeleted])
  @@map("imp_availability_exceptions")
}

// ─── AI-review van inspectierapporten (PRD-13) ───────────────────────────────
// Eén analyse-run van Claude over een ingediend inspectieplan; het resultaat is
// een checklist van aandachtspunten (items) voor de menselijke controleur.
// Adviserend, nooit blokkerend: geen enkele statustransitie hangt hiervan af.

enum AiReviewRunStatus {
  PENDING // aangemaakt, run nog niet gestart/bezig
  COMPLETED // analyse gelukt, items beschikbaar
  FAILED // fout (API/timeout/parse) — errorMessage gevuld
}

enum AiReviewItemSeverity {
  CRITICAL // waarschijnlijk fout in het rapport (bijv. meting buiten norm zonder afwijking)
  WARNING // verdacht / inconsistent, controleren
  SUGGESTION // verbeterpunt (formulering, volledigheid)
  INFO // ter kennisgeving
}

enum AiReviewItemStatus {
  OPEN
  CHECKED // door reviewer afgevinkt (gezien/afgehandeld)
  DISMISSED // door reviewer afgewezen (niet relevant / vals alarm)
}

model AiReviewRun {
  id                  String            @id @default(uuid()) @db.Uuid
  orgId               String            @map("org_id") @db.Uuid
  inspectionPlanId    String            @map("inspection_plan_id") @db.Uuid
  generatedDocumentId String?           @map("generated_document_id") @db.Uuid
  status              AiReviewRunStatus @default(PENDING)
  triggeredBy         String?           @map("triggered_by") @db.Uuid // null = automatisch bij submit
  model               String // gebruikt Claude-model (audit/kosten)
  summary             String?           @db.Text // NL-samenvatting van de AI
  errorMessage        String?           @map("error_message")
  inputTokens         Int?              @map("input_tokens")
  outputTokens        Int?              @map("output_tokens")
  startedAt           DateTime?         @map("started_at")
  completedAt         DateTime?         @map("completed_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  organization      Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inspectionPlan    InspectionPlan     @relation(fields: [inspectionPlanId], references: [id], onDelete: Cascade)
  generatedDocument GeneratedDocument? @relation(fields: [generatedDocumentId], references: [id], onDelete: SetNull)
  triggeredByUser   User?              @relation("AiReviewRunTriggeredBy", fields: [triggeredBy], references: [id], onDelete: SetNull)
  items             AiReviewItem[]

  @@index([orgId, inspectionPlanId])
  @@map("imp_ai_review_runs")
}

model AiReviewItem {
  id                  String               @id @default(uuid()) @db.Uuid
  orgId               String               @map("org_id") @db.Uuid
  runId               String               @map("run_id") @db.Uuid
  severity            AiReviewItemSeverity
  category            String // vrije NL-categorie uit de prompt-taxonomie (PRD §13.6.3)
  title               String
  description         String               @db.Text
  // Optionele verwijzingen zodat de UI kan deeplinken; AI levert deze alleen
  // als het id in de input voorkwam — service valideert vóór opslag.
  assetNodeId         String?              @map("asset_node_id") @db.Uuid
  findingId           String?              @map("finding_id") @db.Uuid
  measurementRecordId String?              @map("measurement_record_id") @db.Uuid
  status              AiReviewItemStatus   @default(OPEN)
  checkedBy           String?              @map("checked_by") @db.Uuid
  checkedAt           DateTime?            @map("checked_at")
  sortOrder           Int                  @default(0) @map("sort_order")
  createdAt           DateTime             @default(now()) @map("created_at")

  run           AiReviewRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  assetNode     AssetNode?  @relation(fields: [assetNodeId], references: [id], onDelete: SetNull)
  finding       Finding?    @relation(fields: [findingId], references: [id], onDelete: SetNull)
  checkedByUser User?       @relation("AiReviewItemCheckedBy", fields: [checkedBy], references: [id], onDelete: SetNull)

  @@index([runId])
  @@map("imp_ai_review_items")
}
