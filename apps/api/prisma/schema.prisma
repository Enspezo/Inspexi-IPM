generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm levert de gin_trgm_ops operator-class voor de typo-tolerante KB-zoek.
  extensions = [pg_trgm]
}

