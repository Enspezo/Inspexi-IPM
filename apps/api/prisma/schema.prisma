/// Per-user favorites ("sterretjes") for records across a fixed allow-list of
/// favoritable models (REQ36). `entityType` holds the canonical Prisma model name
/// (e.g. "Contact", "Quote") so it lines up with the audit entity registry and the
/// frontend ENTITY_TYPE_LABELS / getEntityLink helpers. `entityId` is NOT a real
/// FK (it points at one of several tables), so cross-tenant ownership is validated
/// in the service via assertSameOrg before a favorite is written.
model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([orgId])
  @@map("imp_favorites")
}

