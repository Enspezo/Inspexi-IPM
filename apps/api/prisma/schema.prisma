// ─────────────────────────────────────────────────────────────────────────────
// Interne chat (REQ1) — 1-op-1 (DIRECT) en team-chats (TEAM), polling-MVP.
// `deletedAt` + `syncedAt` + `deviceId` staan alvast klaar voor de additieve
// /sync-uitbreiding (PR2), zodat de PWA-inspecteur poll-based kan meedoen zonder
// een tweede migratie op dezelfde tabellen.
// ─────────────────────────────────────────────────────────────────────────────

enum Availability {
  BESCHIKBAAR
  BEZIG
  AFWEZIG
  OFFLINE
}

enum ChatThreadType {
  DIRECT
  TEAM
}

enum ChatThreadStatus {
  OPEN
  AFGEROND
}

model ChatThread {
  id    String         @id @default(uuid()) @db.Uuid
  orgId String         @map("org_id") @db.Uuid
  type  ChatThreadType

  // TEAM: precies één thread per (org, rol) — afgedwongen via @@unique([orgId, teamRole]).
  // DIRECT: teamRole = null.
  teamRole  Role?   @map("team_role")
  // DIRECT: deterministische sleutel "userIdA:userIdB" (gesorteerd) voor race-vrije dedup
  // via @@unique([orgId, directKey]). TEAM: null.
  directKey String? @map("direct_key")

  subject String?

  // Optionele koppeling naar het huidige record (PascalCase modelnaam, bv. "Request").
  referenceEntityType String? @map("reference_entity_type")
  referenceEntityId   String? @map("reference_entity_id") @db.Uuid

  status   ChatThreadStatus @default(OPEN)
  closedAt DateTime?        @map("closed_at")
  // Notitie die bij afronden op het gerefereerde record is aangemaakt (transcript).
  noteId   String?          @map("note_id") @db.Uuid

  createdById String  @map("created_by_id") @db.Uuid
  deviceId    String? @map("device_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  organization Organization      @relation(fields: [orgId], references: [id])
  createdBy    User              @relation("ChatThreadCreatedBy", fields: [createdById], references: [id])
  participants ChatParticipant[]
  messages     ChatMessage[]

  @@unique([orgId, teamRole])
  @@unique([orgId, directKey])
  @@index([orgId, type])
  @@index([orgId, deletedAt])
  @@index([referenceEntityType, referenceEntityId])
  @@map("imp_chat_threads")
}

model ChatParticipant {
  id         String    @id @default(uuid()) @db.Uuid
  threadId   String    @map("thread_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  lastReadAt DateTime? @map("last_read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User       @relation("ChatParticipantUser", fields: [userId], references: [id])

  @@unique([threadId, userId])
  @@index([userId])
  @@map("imp_chat_participants")
}

model ChatMessage {
  id       String @id @default(uuid()) @db.Uuid
  threadId String @map("thread_id") @db.Uuid
  orgId    String @map("org_id") @db.Uuid
  senderId String @map("sender_id") @db.Uuid
  content  String @db.Text

  mentionedUserIds String[] @default([]) @map("mentioned_user_ids") @db.Uuid

  // Optionele record-referentie via "/" in de composer (PascalCase modelnaam).
  referenceEntityType String? @map("reference_entity_type")
  referenceEntityId   String? @map("reference_entity_id") @db.Uuid

  deviceId String? @map("device_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deletedAt DateTime? @map("deleted_at")

  thread       ChatThread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [orgId], references: [id])
  sender       User         @relation("ChatMessageSender", fields: [senderId], references: [id])

  @@index([threadId, createdAt])
  @@index([orgId, deletedAt])
  @@map("imp_chat_messages")
}

// ─── PRD-10: Helpsysteem ─────────────────────────────────

// Knowledge base (hybride: org_id null = globaal, gezet = org-specifiek)

model HelpCategory {
  id          String       @id @default(uuid()) @db.Uuid
  orgId       String?      @map("org_id") @db.Uuid // null = globaal; gezet = org-specifiek
  slug        String
  name        String
  description String?
  icon        String?
  order       Int          @default(0)
  parentId    String?      @map("parent_id") @db.Uuid
  isPublished Boolean      @default(true) @map("is_published")
  audience    HelpAudience @default(INTERNAL)
  // Alleen relevant voor EXTERNAL: true = publiek zichtbaar (zonder login), false = achter klant-login
  isPublic    Boolean      @default(false) @map("is_public")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  organization Organization?  @relation(fields: [orgId], references: [id])
  parent       HelpCategory?  @relation("HelpCategoryTree", fields: [parentId], references: [id])
  children     HelpCategory[] @relation("HelpCategoryTree")
  articles     HelpArticle[]

  @@unique([orgId, slug])
  @@index([parentId, order])
  @@index([orgId, audience])
  @@map("imp_help_categories")
}

model HelpArticle {
  id          String            @id @default(uuid()) @db.Uuid
  orgId       String?           @map("org_id") @db.Uuid // null = globaal; gezet = org-specifiek
  categoryId  String            @map("category_id") @db.Uuid
  slug        String
  title       String
  excerpt     String?
  body        String            @db.Text
  status      HelpArticleStatus @default(DRAFT)
  audience    HelpAudience      @default(INTERNAL)
  tags        String[]          @default([])
  moduleKeys  String[]          @default([]) @map("module_keys")
  order       Int               @default(0)
  viewCount   Int               @default(0) @map("view_count")
  helpfulYes  Int               @default(0) @map("helpful_yes")
  helpfulNo   Int               @default(0) @map("helpful_no")
  authorId    String?           @map("author_id") @db.Uuid
  publishedAt DateTime?         @map("published_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  organization Organization? @relation(fields: [orgId], references: [id])
  category     HelpCategory  @relation(fields: [categoryId], references: [id])
  author       User?         @relation("HelpArticleAuthor", fields: [authorId], references: [id])

  @@unique([orgId, slug])
  @@index([orgId, status])
  @@index([orgId, audience, status])
  @@index([categoryId, order])
  // pg_trgm/GIN-indexen voor typo-tolerante KB-zoek (oorspronkelijk via raw SQL in
  // 20260623214008_help_trigram_search). Hier in het schema gemodelleerd met de
  // bestaande indexnamen (map:) zodat `migrate dev` ze herkent i.p.v. te willen droppen.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_help_articles_title_trgm")
  @@index([excerpt(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_help_articles_excerpt_trgm")
  @@index([moduleKeys], type: Gin, map: "idx_help_articles_module_keys")
  @@map("imp_help_articles")
}

// Support tickets (org-scoped)

