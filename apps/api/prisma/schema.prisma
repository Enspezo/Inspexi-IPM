generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPERUSER
  ORG_ADMIN
  MANAGER
  BACKOFFICE
  WERKVOORBEREIDER
  INSPECTEUR
}

enum ContactType {
  COMPANY
  INDIVIDUAL
}

enum LogType {
  EMAIL
  PHONE
  MEETING
  NOTE
}

enum PriceType {
  FIXED
  TIERED
}

enum RequestSource {
  MANUAL
  WEB_FORM
  EMAIL
  PHONE
}

enum RequestStatus {
  NIEUW
  IN_BEHANDELING
  OFFERTE_GEMAAKT
  GEWONNEN
  VERLOREN
  ON_HOLD
}

enum LostReason {
  TE_DUUR
  GEEN_BESCHIKBAARHEID
  NIET_LANGER_NODIG
  ANDERS
}

enum Priority {
  LOW
  NORMAL
  HIGH
}

enum ContactPersonRole {
  ALGEMEEN
  TECHNISCH
  ADMINISTRATIEF
  ANDERS
}

enum QuoteStatus {
  CONCEPT
  TER_GOEDKEURING
  GOEDGEKEURD
  VERSTUURD
  BEKEKEN
  GEACCEPTEERD
  AFGEWEZEN
  VERLOPEN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  OFFERTE_TER_GOEDKEURING
  OFFERTE_GOEDGEKEURD
  OFFERTE_AFGEWEZEN
  OFFERTE_VERSTUURD
  OFFERTE_BEKEKEN
  OFFERTE_ONDERTEKEND
  OFFERTE_VERLOPEN
  NIEUWE_VRAAG_KLANT
  ANTWOORD_OP_VRAAG
  AANVRAAG_TOEGEWEZEN
  AANVRAAG_STATUS_GEWIJZIGD
  TAAK_TOEGEWEZEN
  TAAK_STATUS_GEWIJZIGD
  DOCUMENT_GEUPLOAD
  AFSPRAAK_ACCEPTATIE_VERZOEK
  AFSPRAAK_GEACCEPTEERD
  AFSPRAAK_GEWEIGERD
  AFSPRAAK_VERPLAATST
  AFSPRAAK_VERZETTEN_VERZOEK
  AFSPRAAK_BEVESTIGING_VERSTUURD
  PROJECT_AANGEMAAKT
  PROJECT_STATUS_GEWIJZIGD
  FOUTMELDING_INGEDIEND
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum ErrorReportStatus {
  OPEN
  IN_BEHANDELING
  OPGELOST
}

enum TaskStatus {
  TE_DOEN
  MEE_BEZIG
  VOLTOOID
}

enum TaskEntityType {
  CONTACT
  REQUEST
  QUOTE
  PLANNING
  PROJECT
  USER
}

enum DocumentEntityType {
  CONTACT
  REQUEST
  QUOTE
  PRODUCT
  TASK
  PLANNING
  PROJECT
  USER
}

enum NoteEntityType {
  CONTACT
  REQUEST
  QUOTE
  PLANNING
  PROJECT
  USER
}

enum SignatureType {
  DRAW
  UPLOAD
  TEXT
}

enum PlanningStatus {
  NOG_TE_PLANNEN
  CONCEPT
  GEPLAND
  AFGEROND
  VERVALLEN
}

enum AcceptanceStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RescheduleStatus {
  PENDING
  PROCESSED
}

enum SessionStatus {
  NOG_TE_PLANNEN
  CONCEPT
  DEFINITIEF
  AFGEROND
  VERVALLEN
}

enum ProjectStatus {
  ACTIEF
  ON_HOLD
  AFGEROND
  GEANNULEERD
}

enum QuoteTemplateType {
  BLOCKS
  RTF
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
}

enum EmailTemplateType {
  OFFERTE_VERSTUURD
  OFFERTE_ANTWOORD
  AFSPRAAK_BEVESTIGING
  AFSPRAAK_VERPLAATST
  AFSPRAAK_ACCEPTATIE
  CONTACT_EMAIL
  UITNODIGING
  WACHTWOORD_RESET
  NOTIFICATIE
}

enum CustomFieldEntityType {
  CONTACT
  CONTACT_ADDRESS
  LOCATION
  REQUEST
  QUOTE
  PRODUCT
}

// ─── PRD-01: Foundation Models ───────────────────────────

model Organization {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  logoUrl             String?  @map("logo_url")
  primaryColor        String?  @map("primary_color")
  defaultVat          Float    @default(21) @map("default_vat")
  defaultValidityDays Int      @default(30) @map("default_validity_days")
  senderName          String?  @map("sender_name")
  senderEmail         String?  @map("sender_email")
  timezone            String   @default("Europe/Amsterdam")
  workdayStart        Int      @default(8)  @map("workday_start")
  workdayEnd          Int      @default(17) @map("workday_end")
  createdAt           DateTime @default(now()) @map("created_at")

  users       User[]
  invitations Invitation[]
  contacts       Contact[]
  contactPersons ContactPerson[]
  customerGroups CustomerGroup[]
  locations      Location[]
  productGroups  ProductGroup[]
  products       Product[]
  priceTables    PriceTable[]
  requests       Request[]
  quoteTemplates         QuoteTemplate[]
  quotes                 Quote[]
  notifications          Notification[]
  notificationGroupPrefs NotificationGroupPref[]
  tasks                  Task[]
  documents              Document[]
  notes                  Note[]
  planningItems          PlanningItem[]
  customFieldDefinitions CustomFieldDefinition[]
  emailTemplates         EmailTemplate[]
  projects               Project[]
  errorReports           ErrorReport[]

  @@map("imp_organizations")
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  orgId           String?   @map("org_id") @db.Uuid
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  roles           Role[]    @default([])
  isActive        Boolean   @default(true) @map("is_active")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  initials        String?   @map("initials")
  avatarUrl       String?   @map("avatar_url")
  signatureType   SignatureType? @map("signature_type")
  signatureData   String?   @map("signature_data")
  color           String?   // HEX kleurcode voor kalenderweergave, bijv. "#3B82F6"
  homeStreet      String?   @map("home_street")
  homeHouseNumber String?   @map("home_house_number")
  homePostalCode  String?   @map("home_postal_code")
  homeCity        String?   @map("home_city")
  homeLat         Float?    @map("home_lat")
  homeLng         Float?    @map("home_lng")
  icalToken       String    @unique @default(uuid()) @map("ical_token")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization  Organization?  @relation(fields: [orgId], references: [id])
  refreshTokens RefreshToken[]
  ownedContacts Contact[]      @relation("ContactOwner")
  contactLogs   ContactLog[]
  contactEmails ContactEmail[]

  assignedRequests       Request[]              @relation("AssignedToUser")
  createdRequests        Request[]              @relation("CreatedByUser")
  requestStatusChanges   RequestStatusHistory[] @relation("StatusChangedByUser")

  createdQuotes          Quote[]                @relation("QuoteCreatedByUser")
  requestedApprovals     QuoteApprovalRequest[] @relation("ApprovalRequestedByUser")
  reviewedApprovals      QuoteApprovalRequest[] @relation("ApprovalReviewedByUser")
  quoteQuestions         QuoteQuestion[]        @relation("QuoteQuestionUser")

  notifications          Notification[]
  notificationPrefs      NotificationPref[]
  auditLogs              AuditLog[]

  assignedTasks          Task[]                 @relation("TaskAssignee")
  createdTasks           Task[]                 @relation("TaskCreatedBy")
  createdNotes           Note[]                 @relation("NoteCreatedBy")
  uploadedDocuments      Document[]             @relation("DocumentUploadedBy")

  planningInspectors        PlanningInspector[]
  planningFollowers         PlanningFollower[]
  planningHistory           PlanningHistory[]
  createdPlanningItems      PlanningItem[]            @relation("PlanningCreatedByUser")
  planningSessionInspectors PlanningSessionInspector[]
  emailTemplates            EmailTemplate[]            @relation("EmailTemplateCreatedBy")

  managedProjects           Project[]                  @relation("ProjectManager")
  createdProjects           Project[]                  @relation("ProjectCreatedByUser")
  projectFollowers          ProjectFollower[]
  errorReports              ErrorReport[]
  rtfRevisions              QuoteTemplateRtfRevision[]

  @@map("imp_users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("imp_refresh_tokens")
}

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String
  role       Role
  token      String    @unique @default(uuid())
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@map("imp_invitations")
}

// ─── PRD-02: CRM Models ────────────────────────────────

model Contact {
  id           String      @id @default(uuid()) @db.Uuid
  orgId        String      @map("org_id") @db.Uuid
  type         ContactType
  companyName  String?     @map("company_name")
  firstName    String?     @map("first_name")
  lastName     String?     @map("last_name")
  email        String?
  phone        String?
  website      String?
  vatNumber     String?     @map("vat_number")
  vatValidation Json?       @map("vat_validation")
  cocNumber     String?     @map("coc_number")
  notes        String?
  priceTableId String?     @map("price_table_id") @db.Uuid
  ownerId      String?     @map("owner_id") @db.Uuid
  customFields Json?       @map("custom_fields")
  isDeleted    Boolean     @default(false) @map("is_deleted")
  createdAt    DateTime    @default(now()) @map("created_at")

  organization       Organization        @relation(fields: [orgId], references: [id])
  owner              User?               @relation("ContactOwner", fields: [ownerId], references: [id])
  addresses          ContactAddress[]
  contactPersons     ContactPerson[]
  customerGroups     ContactCustomerGroup[]
  locations          Location[]
  logs               ContactLog[]
  emails             ContactEmail[]
  contactPriceTables ContactPriceTable[]
  requests           Request[]
  quotes             Quote[]
  planningItems      PlanningItem[]
  projects           Project[]

  @@map("imp_contacts")
}

model ContactAddress {
  id          String  @id @default(uuid()) @db.Uuid
  contactId   String  @map("contact_id") @db.Uuid
  label       String
  street      String
  houseNumber String  @map("house_number")
  postalCode  String  @map("postal_code")
  city        String
  country     String  @default("NL")
  isPrimary    Boolean @default(false) @map("is_primary")
  isPostal     Boolean @default(false) @map("is_postal")
  isInvoice    Boolean @default(false) @map("is_invoice")
  customFields Json?   @map("custom_fields")

  contact Contact @relation(fields: [contactId], references: [id])

  @@map("imp_contact_addresses")
}

model CustomerGroup {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization           @relation(fields: [orgId], references: [id])
  contacts     ContactCustomerGroup[]

  @@map("imp_customer_groups")
}

model ContactCustomerGroup {
  id              String @id @default(uuid()) @db.Uuid
  contactId       String @map("contact_id") @db.Uuid
  customerGroupId String @map("customer_group_id") @db.Uuid

  contact       Contact       @relation(fields: [contactId], references: [id])
  customerGroup CustomerGroup @relation(fields: [customerGroupId], references: [id])

  @@unique([contactId, customerGroupId])
  @@map("imp_contact_customer_groups")
}

model ContactPerson {
  id        String            @id @default(uuid()) @db.Uuid
  contactId String            @map("contact_id") @db.Uuid
  orgId     String            @map("org_id") @db.Uuid
  firstName String            @map("first_name")
  lastName  String            @map("last_name")
  email     String?
  phone     String?
  role      ContactPersonRole @default(ALGEMEEN)
  notes     String?
  isDeleted Boolean           @default(false) @map("is_deleted")
  createdAt DateTime          @default(now()) @map("created_at")

  contact      Contact      @relation(fields: [contactId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])
  planningItems PlanningItem[]

  @@map("imp_contact_persons")
}

model Location {
  id          String   @id @default(uuid()) @db.Uuid
  contactId   String   @map("contact_id") @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  street      String
  houseNumber String   @map("house_number")
  postalCode  String   @map("postal_code")
  city        String
  objectType   String?  @map("object_type")
  notes        String?
  pdokData     Json?    @map("pdok_data")
  lat          Float?
  lng          Float?
  customFields Json?    @map("custom_fields")
  createdAt    DateTime @default(now()) @map("created_at")

  contact      Contact      @relation(fields: [contactId], references: [id])
  organization Organization @relation(fields: [orgId], references: [id])
  requests     Request[]
  quotes       Quote[]
  planningItems PlanningItem[]
  projects      Project[]

  @@map("imp_locations")
}

model ContactLog {
  id        String   @id @default(uuid()) @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      LogType
  subject   String?
  body      String?
  loggedAt  DateTime @default(now()) @map("logged_at")
  createdAt DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("imp_contact_logs")
}

model ContactEmail {
  id       String    @id @default(uuid()) @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  orgId    String    @map("org_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  resendId String?   @map("resend_id")
  subject  String
  bodyHtml String    @map("body_html")
  sentAt   DateTime  @default(now()) @map("sent_at")
  openedAt DateTime? @map("opened_at")

  contact Contact @relation(fields: [contactId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@map("imp_contact_emails")
}

// ─── PRD-04: Products & Price Tables ────────────────────

model ProductGroup {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  notes     String?
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  products     Product[]

  @@map("imp_product_groups")
}

model Product {
  id             String  @id @default(uuid()) @db.Uuid
  orgId          String  @map("org_id") @db.Uuid
  productGroupId String? @map("product_group_id") @db.Uuid
  name           String
  description    String?
  unit           String
  defaultVat     Float   @default(21) @map("default_vat")
  isActive       Boolean @default(true) @map("is_active")
  customFields   Json?    @map("custom_fields")
  createdAt      DateTime @default(now()) @map("created_at")

  organization  Organization  @relation(fields: [orgId], references: [id])
  productGroup  ProductGroup? @relation(fields: [productGroupId], references: [id])
  priceTableItems PriceTableItem[]
  quoteLines      QuoteLine[]

  @@map("imp_products")
}

model PriceTable {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  organization       Organization        @relation(fields: [orgId], references: [id])
  items              PriceTableItem[]
  contactPriceTables ContactPriceTable[]

  @@map("imp_price_tables")
}

model PriceTableItem {
  id           String    @id @default(uuid()) @db.Uuid
  priceTableId String    @map("price_table_id") @db.Uuid
  productId    String    @map("product_id") @db.Uuid
  priceType    PriceType @map("price_type")
  basePrice    Float?    @map("base_price")
  createdAt    DateTime  @default(now()) @map("created_at")

  priceTable PriceTable @relation(fields: [priceTableId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  tiers      PriceTier[]

  @@map("imp_price_table_items")
}

model PriceTier {
  id               String @id @default(uuid()) @db.Uuid
  priceTableItemId String @map("price_table_item_id") @db.Uuid
  fromQty          Float  @map("from_qty")
  toQty            Float? @map("to_qty")
  price            Float

  priceTableItem PriceTableItem @relation(fields: [priceTableItemId], references: [id])

  @@map("imp_price_tiers")
}

model ContactPriceTable {
  contactId    String @map("contact_id") @db.Uuid
  priceTableId String @map("price_table_id") @db.Uuid

  contact    Contact    @relation(fields: [contactId], references: [id])
  priceTable PriceTable @relation(fields: [priceTableId], references: [id])

  @@id([contactId, priceTableId])
  @@map("imp_contact_price_tables")
}

// ─── PRD-03: Requests (Leads & Aanvragen) ────────────────

model Request {
  id          String        @id @default(uuid()) @db.Uuid
  orgId       String        @map("org_id") @db.Uuid
  contactId   String        @map("contact_id") @db.Uuid
  locationId  String?       @map("location_id") @db.Uuid
  assignedTo  String?       @map("assigned_to") @db.Uuid
  source      RequestSource
  status      RequestStatus @default(NIEUW)
  lostReason  LostReason?   @map("lost_reason")
  lostNote    String?       @map("lost_note")
  title       String
  description String?
  priority     Priority      @default(NORMAL)
  customFields Json?         @map("custom_fields")
  createdBy    String        @map("created_by") @db.Uuid
  isDeleted    Boolean       @default(false) @map("is_deleted")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  projectId     String?                @map("project_id") @db.Uuid

  organization  Organization           @relation(fields: [orgId], references: [id])
  contact       Contact                @relation(fields: [contactId], references: [id])
  location      Location?              @relation(fields: [locationId], references: [id])
  assignedUser  User?                  @relation("AssignedToUser", fields: [assignedTo], references: [id])
  createdByUser User                   @relation("CreatedByUser", fields: [createdBy], references: [id])
  project       Project?               @relation(fields: [projectId], references: [id])
  statusHistory RequestStatusHistory[]
  quotes        Quote[]

  @@map("imp_requests")
}

model RequestStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  requestId  String         @map("request_id") @db.Uuid
  fromStatus RequestStatus? @map("from_status")
  toStatus   RequestStatus  @map("to_status")
  changedBy  String         @map("changed_by") @db.Uuid
  changedAt  DateTime       @default(now()) @map("changed_at")
  note       String?

  request       Request @relation(fields: [requestId], references: [id])
  changedByUser User    @relation("StatusChangedByUser", fields: [changedBy], references: [id])

  @@map("imp_request_status_history")
}

// ─── PRD-05: Quotes (Offertes) ────────────────────────────

model QuoteTemplate {
  id                  String             @id @default(uuid()) @db.Uuid
  orgId               String             @map("org_id") @db.Uuid
  name                String
  description         String?            @db.Text
  templateType        QuoteTemplateType  @default(BLOCKS) @map("template_type")
  coverBlocks         Json?              @map("cover_blocks")
  contentBlocks       Json?              @map("content_blocks")
  closingBlocks       Json?              @map("closing_blocks")
  rtfStorageKey       String?            @map("rtf_storage_key")
  rtfFileName         String?            @map("rtf_file_name")
  rtfFileSize         Int?               @map("rtf_file_size")
  rtfPreviewHtml      String?            @map("rtf_preview_html") @db.Text
  defaultValidityDays Int                @default(30) @map("default_validity_days")
  requiresApproval    Boolean            @default(false) @map("requires_approval")
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  organization Organization              @relation(fields: [orgId], references: [id])
  quotes       Quote[]
  attachments  QuoteTemplateAttachment[]
  rtfRevisions QuoteTemplateRtfRevision[]

  @@map("imp_quote_templates")
}

model QuoteTemplateAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  storageKey String   @map("storage_key")
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  fileSize   Int      @map("file_size")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  template QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("imp_quote_template_attachments")
}

model QuoteTemplateRtfRevision {
  id           String   @id @default(uuid()) @db.Uuid
  templateId   String   @map("template_id") @db.Uuid
  storageKey   String   @map("storage_key")
  fileName     String   @map("file_name")
  fileSize     Int      @map("file_size")
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  template   QuoteTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation(fields: [uploadedById], references: [id])

  @@index([templateId])
  @@map("imp_quote_template_rtf_revisions")
}

model Quote {
  id               String      @id @default(uuid()) @db.Uuid
  orgId            String      @map("org_id") @db.Uuid
  quoteNumber      String      @unique @map("quote_number")
  templateId       String?     @map("template_id") @db.Uuid
  requestId        String?     @map("request_id") @db.Uuid
  contactId        String      @map("contact_id") @db.Uuid
  locationId       String?     @map("location_id") @db.Uuid
  status           QuoteStatus @default(CONCEPT)
  subject          String
  coverBlocks      Json?       @map("cover_blocks")
  contentBlocks    Json?       @map("content_blocks")
  closingBlocks    Json?       @map("closing_blocks")
  subtotal         Float       @default(0)
  discountTotal    Float       @default(0) @map("discount_total")
  vatTotal         Float       @default(0) @map("vat_total")
  total            Float       @default(0)
  validUntil       DateTime?   @map("valid_until")
  requiresApproval Boolean     @default(false) @map("requires_approval")
  internalNotes    String?     @map("internal_notes")
  customFields     Json?       @map("custom_fields")
  createdBy        String      @map("created_by") @db.Uuid

  // Send & client portal fields
  sentAt           DateTime?   @map("sent_at")
  viewedAt         DateTime?   @map("viewed_at")
  signedAt         DateTime?   @map("signed_at")
  clientName       String?     @map("client_name")
  clientSignature  String?     @map("client_signature")
  clientIp         String?     @map("client_ip")
  clientUserAgent  String?     @map("client_user_agent")
  managerSignature String?     @map("manager_signature")
  publicToken      String?     @unique @map("public_token")

  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  projectId        String?               @map("project_id") @db.Uuid

  organization     Organization          @relation(fields: [orgId], references: [id])
  template         QuoteTemplate?        @relation(fields: [templateId], references: [id])
  request          Request?              @relation(fields: [requestId], references: [id])
  contact          Contact               @relation(fields: [contactId], references: [id])
  location         Location?             @relation(fields: [locationId], references: [id])
  createdByUser    User                  @relation("QuoteCreatedByUser", fields: [createdBy], references: [id])
  project          Project?              @relation(fields: [projectId], references: [id])
  lines            QuoteLine[]
  approvalRequests QuoteApprovalRequest[]
  questions        QuoteQuestion[]
  attachments      QuoteAttachment[]

  @@map("imp_quotes")
}

model QuoteQuestion {
  id           String   @id @default(uuid()) @db.Uuid
  quoteId      String   @map("quote_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  message      String
  isFromClient Boolean  @default(false) @map("is_from_client")
  createdAt    DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  user  User? @relation("QuoteQuestionUser", fields: [userId], references: [id])

  @@index([quoteId])
  @@map("imp_quote_questions")
}

model QuoteAttachment {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  storageKey  String  @map("storage_key")
  fileName    String  @map("file_name")
  mimeType    String  @map("mime_type")
  fileSize    Int     @map("file_size")
  isStandard  Boolean @default(false) @map("is_standard")
  sortOrder   Int     @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("imp_quote_attachments")
}

model QuoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  productId   String? @map("product_id") @db.Uuid
  description String
  quantity    Float
  unit        String
  unitPrice   Float   @map("unit_price")
  vatRate     Float   @default(21) @map("vat_rate")
  discountPct Float   @default(0) @map("discount_pct")
  lineTotal   Float   @map("line_total")
  sortOrder   Int     @default(0) @map("sort_order")

  quote   Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@map("imp_quote_lines")
}

model QuoteApprovalRequest {
  id          String         @id @default(uuid()) @db.Uuid
  quoteId     String         @map("quote_id") @db.Uuid
  requestedBy String         @map("requested_by") @db.Uuid
  reviewedBy  String?        @map("reviewed_by") @db.Uuid
  status      ApprovalStatus @default(PENDING)
  note        String?
  requestedAt DateTime       @default(now()) @map("requested_at")
  reviewedAt  DateTime?      @map("reviewed_at")

  quote           Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestedByUser User  @relation("ApprovalRequestedByUser", fields: [requestedBy], references: [id])
  reviewedByUser  User? @relation("ApprovalReviewedByUser", fields: [reviewedBy], references: [id])

  @@map("imp_quote_approval_requests")
}

// ─── PRD-06: Notifications ────────────────────────────────

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  orgId      String?          @map("org_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  body       String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id") @db.Uuid
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  organization Organization? @relation(fields: [orgId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@map("imp_notifications")
}

model NotificationPref {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  notificationType NotificationType @map("notification_type")
  channelInApp     Boolean          @default(true) @map("channel_in_app")
  channelEmail     Boolean          @default(true) @map("channel_email")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, notificationType])
  @@map("imp_notification_prefs")
}

model NotificationGroupPref {
  id               String           @id @default(uuid()) @db.Uuid
  orgId            String           @map("org_id") @db.Uuid
  role             Role
  notificationType NotificationType @map("notification_type")
  channelInApp     Boolean          @default(true) @map("channel_in_app")
  channelEmail     Boolean          @default(true) @map("channel_email")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, role, notificationType])
  @@map("imp_notification_group_prefs")
}

// ─── Audit Trail ─────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  orgId      String?     @map("org_id") @db.Uuid
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  action     AuditAction
  changes    Json?
  snapshot   Json?
  userId     String      @map("user_id") @db.Uuid
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([orgId, createdAt])
  @@index([userId])
  @@map("imp_audit_logs")
}

// ─── Task Management ─────────────────────────────────────

model Task {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  title       String
  description String?
  status      TaskStatus     @default(TE_DOEN)
  entityType  TaskEntityType @map("entity_type")
  entityId    String         @map("entity_id") @db.Uuid
  assigneeId  String?        @map("assignee_id") @db.Uuid
  createdById String         @map("created_by_id") @db.Uuid
  deadline    DateTime?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy    User         @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([orgId, status])
  @@index([assigneeId])
  @@index([entityType, entityId])
  @@map("imp_tasks")
}

// ─── Document Management ────────────────────────────────

model Document {
  id           String             @id @default(uuid()) @db.Uuid
  orgId        String             @map("org_id") @db.Uuid
  entityType   DocumentEntityType @map("entity_type")
  entityId     String             @map("entity_id") @db.Uuid
  fileName     String             @map("file_name")
  originalName String             @map("original_name")
  mimeType     String             @map("mime_type")
  size         Int
  storageKey   String             @map("storage_key")
  description        String?
  uploadedById       String             @map("uploaded_by_id") @db.Uuid
  isDeleted          Boolean            @default(false) @map("is_deleted")
  isSharedWithClient Boolean            @default(false) @map("is_shared_with_client")
  createdAt          DateTime           @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id])
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])

  @@index([orgId, entityType, entityId])
  @@index([uploadedById])
  @@map("imp_documents")
}

// ─── PRD-07: Planning & Afspraken ───────────────────────

model PlanningItem {
  id             String         @id @default(uuid()) @db.Uuid
  orgId          String         @map("org_id") @db.Uuid
  quoteId        String?        @map("quote_id") @db.Uuid
  contactId      String         @map("contact_id") @db.Uuid
  contactPersonId String?       @map("contact_person_id") @db.Uuid
  locationId     String?        @map("location_id") @db.Uuid
  productId      String?        @map("product_id") @db.Uuid
  productName    String         @map("product_name")
  status         PlanningStatus @default(NOG_TE_PLANNEN)
  isCancelled    Boolean        @default(false) @map("is_cancelled")
  cancelledAt    DateTime?      @map("cancelled_at")
  cancelledBy    String?        @map("cancelled_by") @db.Uuid
  cancelReason   String?        @map("cancel_reason")

  scheduledDate  DateTime?      @map("scheduled_date")
  durationHours  Float?         @map("duration_hours")
  endTime        DateTime?      @map("end_time")

  isMultiDay     Boolean        @default(false) @map("is_multi_day")
  sessionCount   Int?           @map("session_count")

  labels         String[]       @default([])
  internalNotes  String?        @map("internal_notes")
  publicToken    String         @unique @default(uuid()) @map("public_token")

  // Stored as plain strings (not Prisma relations) to avoid self-referential complexity
  replacedById   String?        @map("replaced_by_id") @db.Uuid
  replacesId     String?        @map("replaces_id") @db.Uuid
  originalDate   DateTime?      @map("original_date")

  createdBy      String         @map("created_by") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  projectId      String?        @map("project_id") @db.Uuid

  organization   Organization   @relation(fields: [orgId], references: [id])
  contact        Contact        @relation(fields: [contactId], references: [id])
  contactPerson  ContactPerson? @relation(fields: [contactPersonId], references: [id])
  location       Location?      @relation(fields: [locationId], references: [id])
  createdByUser  User           @relation("PlanningCreatedByUser", fields: [createdBy], references: [id])
  project        Project?       @relation(fields: [projectId], references: [id])
  inspectors     PlanningInspector[]
  history        PlanningHistory[]
  rescheduleRequests RescheduleRequest[]
  followers      PlanningFollower[]
  sessions       PlanningSession[]

  @@index([orgId, status])
  @@index([orgId, scheduledDate])
  @@index([contactId])
  @@map("imp_planning_items")
}

model PlanningInspector {
  id               String           @id @default(uuid()) @db.Uuid
  planningItemId   String           @map("planning_item_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  isPrimary        Boolean          @default(false) @map("is_primary")
  acceptanceStatus AcceptanceStatus @default(PENDING) @map("acceptance_status")
  acceptedAt       DateTime?        @map("accepted_at")
  rejectedAt       DateTime?        @map("rejected_at")
  rejectionNote    String?          @map("rejection_note")

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([planningItemId, userId])
  @@map("imp_planning_inspectors")
}

model PlanningHistory {
  id             String   @id @default(uuid()) @db.Uuid
  planningItemId String   @map("planning_item_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  description    String
  oldValue       String?  @map("old_value")
  newValue       String?  @map("new_value")
  createdAt      DateTime @default(now()) @map("created_at")

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([planningItemId])
  @@map("imp_planning_history")
}

model RescheduleRequest {
  id             String           @id @default(uuid()) @db.Uuid
  planningItemId String           @map("planning_item_id") @db.Uuid
  requestedBy    String?          @map("requested_by") @db.Uuid
  clientName     String?          @map("client_name")
  preferredDate  DateTime         @map("preferred_date")
  reason         String
  status         RescheduleStatus @default(PENDING)
  processedBy    String?          @map("processed_by") @db.Uuid
  processedAt    DateTime?        @map("processed_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)

  @@index([planningItemId])
  @@map("imp_reschedule_requests")
}

model PlanningFollower {
  id             String   @id @default(uuid()) @db.Uuid
  planningItemId String   @map("planning_item_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  email          String?
  name           String?
  createdAt      DateTime @default(now()) @map("created_at")

  planningItem PlanningItem @relation(fields: [planningItemId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([planningItemId])
  @@map("imp_planning_followers")
}

model PlanningSession {
  id              String        @id @default(uuid()) @db.Uuid
  planningItemId  String        @map("planning_item_id") @db.Uuid
  sessionNumber   Int           @map("session_number")
  scheduledDate   DateTime?     @map("scheduled_date")
  durationHours   Float?        @map("duration_hours")
  status          SessionStatus @default(NOG_TE_PLANNEN)
  notes           String?
  isDefinitief    Boolean       @default(false) @map("is_definitief")
  confirmedAt     DateTime?     @map("confirmed_at")
  confirmedBy     String?       @map("confirmed_by") @db.Uuid
  // Reschedule tracking (same pattern as PlanningItem — stored as plain strings)
  replacedById    String?       @map("replaced_by_id")
  replacesId      String?       @map("replaces_id")
  originalDate    DateTime?     @map("original_date")
  isCancelled     Boolean       @default(false) @map("is_cancelled")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  planningItem      PlanningItem               @relation(fields: [planningItemId], references: [id], onDelete: Cascade)
  sessionInspectors PlanningSessionInspector[]

  @@index([planningItemId, sessionNumber])
  @@index([planningItemId, scheduledDate])
  @@map("imp_planning_sessions")
}

model PlanningSessionInspector {
  id               String           @id @default(uuid()) @db.Uuid
  sessionId        String           @map("session_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  isPrimary        Boolean          @default(false) @map("is_primary")
  acceptanceStatus AcceptanceStatus @default(PENDING) @map("acceptance_status")
  acceptedAt       DateTime?        @map("accepted_at")
  rejectedAt       DateTime?        @map("rejected_at")
  rejectionNote    String?          @map("rejection_note")

  session   PlanningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@map("imp_planning_session_inspectors")
}

// ─── Projects (Dossiers) ────────────────────────────────

model Project {
  id               String        @id @default(uuid()) @db.Uuid
  orgId            String        @map("org_id") @db.Uuid
  projectNumber    String        @unique @map("project_number")
  title            String
  description      String?
  status           ProjectStatus @default(ACTIEF)
  contactId        String        @map("contact_id") @db.Uuid
  locationId       String?       @map("location_id") @db.Uuid
  projectManagerId String        @map("project_manager_id") @db.Uuid
  startDate        DateTime      @default(now()) @map("start_date")
  expectedEndDate  DateTime?     @map("expected_end_date")
  endDate          DateTime?     @map("end_date")
  isDeleted        Boolean       @default(false) @map("is_deleted")
  deletedAt        DateTime?     @map("deleted_at")
  createdBy        String        @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [orgId], references: [id])
  contact        Contact           @relation(fields: [contactId], references: [id])
  location       Location?         @relation(fields: [locationId], references: [id])
  projectManager User              @relation("ProjectManager", fields: [projectManagerId], references: [id])
  createdByUser  User              @relation("ProjectCreatedByUser", fields: [createdBy], references: [id])
  followers      ProjectFollower[]
  requests       Request[]
  quotes         Quote[]
  planningItems  PlanningItem[]

  @@index([orgId, status])
  @@index([contactId])
  @@index([projectManagerId])
  @@map("imp_projects")
}

model ProjectFollower {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  name      String?
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@map("imp_project_followers")
}

// ─── Custom Fields ──────────────────────────────────────

model CustomFieldDefinition {
  id          String                @id @default(uuid()) @db.Uuid
  orgId       String                @map("org_id") @db.Uuid
  entityType  CustomFieldEntityType @map("entity_type")
  fieldName   String                @map("field_name")
  label       String
  fieldType   CustomFieldType       @map("field_type")
  options     Json?
  isRequired  Boolean               @default(false) @map("is_required")
  sortOrder   Int                   @default(0) @map("sort_order")
  isDeleted   Boolean               @default(false) @map("is_deleted")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, entityType, fieldName])
  @@index([orgId, entityType])
  @@map("imp_custom_field_definitions")
}

// ─── Email Templates ────────────────────────────────────

model EmailTemplate {
  id        String            @id @default(uuid()) @db.Uuid
  orgId     String            @map("org_id") @db.Uuid
  type      EmailTemplateType
  name      String
  subject   String
  bodyJson  Json              @map("body_json")
  bodyHtml  String            @map("body_html") @db.Text
  isActive  Boolean           @default(true) @map("is_active")
  createdBy String            @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  creator      User         @relation("EmailTemplateCreatedBy", fields: [createdBy], references: [id])

  @@index([orgId, type])
  @@map("imp_email_templates")
}

// ─── Error Reports (Helpdesk Meldingen) ─────────────────

model ErrorReport {
  id              String            @id @default(uuid()) @db.Uuid
  orgId           String?           @map("org_id") @db.Uuid
  userId          String?           @map("user_id") @db.Uuid
  errorMessage    String            @map("error_message")
  stackTrace      String?           @map("stack_trace") @db.Text
  componentStack  String?           @map("component_stack") @db.Text
  userDescription String?           @map("user_description") @db.Text
  pageUrl         String?           @map("page_url")
  userAgent       String?           @map("user_agent")
  metadata        Json?
  status          ErrorReportStatus @default(OPEN)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization    Organization?     @relation(fields: [orgId], references: [id])
  user            User?             @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@map("imp_error_reports")
}

// ─── Notes (Threaded) ────────────────────────────────────

model Note {
  id          String         @id @default(uuid()) @db.Uuid
  orgId       String         @map("org_id") @db.Uuid
  entityType  NoteEntityType @map("entity_type")
  entityId    String         @map("entity_id") @db.Uuid
  content     String
  createdById String         @map("created_by_id") @db.Uuid
  parentId    String?        @map("parent_id") @db.Uuid
  isDeleted   Boolean        @default(false) @map("is_deleted")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id])
  createdBy    User         @relation("NoteCreatedBy", fields: [createdById], references: [id])
  parent       Note?        @relation("NoteReplies", fields: [parentId], references: [id])
  replies      Note[]       @relation("NoteReplies")

  @@index([orgId, entityType, entityId])
  @@index([parentId])
  @@index([createdById])
  @@map("imp_notes")
}
