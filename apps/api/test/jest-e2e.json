{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@inspexi/calibration$": "<rootDir>/../../../packages/calibration/src/index.ts",
    "^@inspexi/entitlements$": "<rootDir>/../../../packages/entitlements/src/index.ts",
    "^@/(.*)$": "<rootDir>/../src/$1"
  },
  "maxWorkers": 1
}
