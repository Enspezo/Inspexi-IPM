# Port for the convert API (default: 3002)
CONVERT_API_PORT=3002

# Shared secret for API key authentication
# Must match CONVERT_API_KEY in the main API's .env
# Use a unique secret of at least 16 characters; the placeholder is refused when NODE_ENV=production
CONVERT_API_KEY=change-me-in-production

# LibreOffice conversion timeout in milliseconds (default: 60000)
CONVERT_TIMEOUT_MS=60000
