# Staf-portal (2e app) — Vite build-time env vars.
#
# De API-basis is altijd relatief ('/api/v1' via de Vite-/reverse-proxy), zodat de
# Host-header (org-subdomein) behouden blijft voor de tenant-resolutie. Er is dus
# GEEN VITE_API_URL nodig.

# Basis-URL van het KLANT-portaal, voor "open klantportaal"-links vanuit de staf-UI.
# Ondersteunt een optionele {slug}-placeholder die door het huidige org-subdomein
# wordt vervangen. Leeg = afgeleid van het huidige subdomein (dev).
# Prod-voorbeeld: https://{slug}.klant.inspexi.nl
VITE_CLIENT_PORTAL_BASE=

# Optionele override van de PDOK-luchtfoto WMS-base-URL (best-effort kaartlaag op
# de locatie-plattegrond). Leeg = ingebouwde PDOK-default.
VITE_PDOK_LUCHTFOTO_WMS_URL=
