// ─── Per-org lookup-tabellen (overschrijfbare status/type-lijsten) ──
// Beheer-stijl: orgId null = globale systeemdefault; org-rij met dezelfde
// `code` overschrijft label/kleur/volgorde/actief voor die org. Entiteiten
// bewaren alleen de `code`-string; de service resolveert met org-voorrang:
//   WHERE code = :code AND (org_id = :orgId OR org_id IS NULL) ORDER BY org_id NULLS LAST
// Geen harde Prisma-relatie (code is niet globaal uniek); validatie in service.
// Vaste systeemcodes blijven leidend voor state-machine-logica; orgs mogen
// herlabelen of EIGEN extra codes toevoegen.

model InspectionTypeOption {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String?  @map("org_id") @db.Uuid
  code      String
  label     String
  color     String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [orgId], references: [id])

  @@unique([orgId, code])
  @@index([orgId, isActive])
  @@map("imp_inspection_types")
}

