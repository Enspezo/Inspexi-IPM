  clientUser            ClientUser      @relation(fields: [clientUserId], references: [id])
  relatedInspectionPlan InspectionPlan? @relation("RelatedInspectionPlan", fields: [relatedInspectionPlanId], references: [id])

  @@index([orgId, status])
  @@index([contactId])
  @@map("imp_client_requests")
}


// ─── Voice-prompt-lagen ──────────────────────────────────

model VoiceBasePrompt {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  content   String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("imp_voice_base_prompts")
}

model VoiceTemplatePrompt {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  content    String   @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [orgId], references: [id])
  template     MeasurementSheetTemplate @relation(fields: [templateId], references: [id])

  @@unique([orgId, templateId])
  @@index([orgId])
  @@index([templateId])
  @@map("imp_voice_template_prompts")
}

model VoiceUserPrompt {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  templateId String?  @map("template_id") @db.Uuid
  content    String   @db.Text
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User                      @relation("VoiceUserPromptUser", fields: [userId], references: [id])
  template MeasurementSheetTemplate? @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
  @@map("imp_voice_user_prompts")
}
