// ─── Norm & Classificatie ────────────────────────────────

/// Lookup van inspectienormen (NEN1010, SCOPE_8, ...). Globaal (geen orgId).
model NormTypeDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  label       String
  description String?
  assetTypes  String[] @map("asset_types")

  classificationModelId String?              @map("classification_model_id") @db.Uuid
  classificationModel   ClassificationModel? @relation(fields: [classificationModelId], references: [id])

  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String    @map("created_by") @db.Uuid

  @@index([isActive])
  @@index([code])
  @@index([classificationModelId])
  @@map("imp_norm_type_definitions")
}

/// Per-org of globale (orgId null) configuratie van een norm-versie.
model NormConfiguration {
  id          String  @id @default(uuid()) @db.Uuid
  orgId       String? @map("org_id") @db.Uuid
  normTypeCode String @map("norm_type")
  normVersion String  @map("norm_version")
  name        String
  description String?
  assetTypes  Json    @default("[]") @map("asset_types")
  isActive    Boolean @default(true) @map("is_active")
  validFrom   DateTime? @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization              Organization?              @relation(fields: [orgId], references: [id])
  measurementFieldTemplates MeasurementFieldTemplate[]

  @@index([orgId])
  @@index([normTypeCode])
  @@map("imp_norm_configurations")
}

/// Classificatiemodel (alleen systeemniveau).
model ClassificationModel {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @map("created_by") @db.Uuid

  characteristics     ClassificationCharacteristic[]
  findingTemplates    FindingTemplate[]
  normTypeDefinitions NormTypeDefinition[]
  inspectionTemplates InspectionTemplate[]

  @@index([isActive])
  @@map("imp_classification_models")
}

model ClassificationCharacteristic {
  id                    String @id @default(uuid()) @db.Uuid
  classificationModelId String @map("classification_model_id") @db.Uuid
  code        String
  name        String
  description String?
  sortOrder   Int    @default(0) @map("sort_order")

  classificationModel ClassificationModel    @relation(fields: [classificationModelId], references: [id], onDelete: Cascade)
  options             ClassificationOption[]

  @@unique([classificationModelId, code])
  @@index([classificationModelId, sortOrder])
  @@map("imp_classification_characteristics")
}

model ClassificationOption {
  id               String @id @default(uuid()) @db.Uuid
  characteristicId String @map("characteristic_id") @db.Uuid
  code        String
  name        String
  description String?
  color       String
  sortOrder   Int    @default(0) @map("sort_order")

  characteristic ClassificationCharacteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  @@unique([characteristicId, code])
  @@index([characteristicId, sortOrder])
  @@map("imp_classification_options")
}


// ─── Inspectieplan (kern) ────────────────────────────────

model InspectionPlan {
  id        String  @id @default(uuid()) @db.Uuid
  orgId     String  @map("org_id") @db.Uuid
  contactId String  @map("contact_id") @db.Uuid          // was clientId → Beheer Contact
  projectId String? @map("project_id") @db.Uuid          // Beheer Project

  inspectionTemplateId String? @map("inspection_template_id") @db.Uuid

  projectName     String  @map("project_name")
  description     String?
  referenceNumber String? @map("reference_number")

  normTypeCode       String @map("norm_type")
  inspectionTypeCode String @default("initial") @map("inspection_type")  // → imp_inspection_types.code

  addressStreet      String?  @map("address_street")
  addressHouseNumber String?  @map("address_house_number")
  addressPostalCode  String?  @map("address_postal_code")
  addressCity        String?  @map("address_city")
  gpsLatitude        Decimal? @map("gps_latitude") @db.Decimal(10, 8)
  gpsLongitude       Decimal? @map("gps_longitude") @db.Decimal(11, 8)

  plannedDate          DateTime? @map("planned_date") @db.Date
  plannedDurationHours Decimal?  @map("planned_duration_hours") @db.Decimal(4, 1)
  deadline             DateTime? @db.Date

  assignedTo String? @map("assigned_to") @db.Uuid
  reviewerId String? @map("reviewer_id") @db.Uuid

  statusCode  String     @default("draft") @map("status")  // → imp_plan_status_types.code
  startedAt   DateTime?  @map("started_at")
  submittedAt DateTime?  @map("submitted_at")
  reviewedAt  DateTime?  @map("reviewed_at")
  approvedAt  DateTime?  @map("approved_at")
  completedAt DateTime?  @map("completed_at")

  installationResponsibleId String? @map("installation_responsible_id") @db.Uuid // → ContactPerson

  notes         String?
  internalNotes String? @map("internal_notes")
  metadata      Json    @default("{}")

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  syncedAt       DateTime? @map("synced_at")
  createdBy      String?   @map("created_by") @db.Uuid
  lastModifiedBy String?   @map("last_modified_by") @db.Uuid
  deviceId       String?   @map("device_id")
  deletedAt      DateTime? @map("deleted_at")

  organization            Organization        @relation(fields: [orgId], references: [id])
  contact                 Contact             @relation(fields: [contactId], references: [id])
  project                 Project?            @relation(fields: [projectId], references: [id])
  assignedUser            User?               @relation("InspectionPlanAssignee", fields: [assignedTo], references: [id])
  reviewer                User?               @relation("InspectionPlanReviewer", fields: [reviewerId], references: [id])
  installationResponsible ContactPerson?      @relation("PlanInstallationResponsible", fields: [installationResponsibleId], references: [id])
  createdByUser           User?               @relation("InspectionPlanCreatedBy", fields: [createdBy], references: [id])
  lastModifiedByUser      User?               @relation("InspectionPlanModifiedBy", fields: [lastModifiedBy], references: [id])
  inspectionTemplate      InspectionTemplate? @relation(fields: [inspectionTemplateId], references: [id])

  assets                  Asset[]
  locations               InspectionLocation[]
  signatures              Signature[]
  reports                 Report[]
  measurementSheetRecords MeasurementSheetRecord[]
  generatedDocuments      GeneratedDocument[]
  clientAccess            InspectionClientAccess[]
  magicLinks              ClientMagicLink[]
  inspectionMessages      InspectionMessage[]
  clientRequests          ClientRequest[]          @relation("RelatedInspectionPlan")
  standaloneMeasurements  StandaloneMeasurement[]

  @@index([orgId, status])
  @@index([contactId])
  @@index([projectId])
  @@index([assignedTo])
  @@map("imp_inspection_plans")
}

model Asset {
  id               String  @id @default(uuid()) @db.Uuid
  orgId            String  @map("org_id") @db.Uuid          // denormaliseerd voor tenant-scope
  inspectionPlanId String  @map("inspection_plan_id") @db.Uuid
  parentAssetId    String? @map("parent_asset_id") @db.Uuid
  locationId       String? @map("location_id") @db.Uuid

  assetType           String  @map("asset_type")
  name                String
  identifier          String?
  locationDescription String? @map("location_description")

  sortOrder Int     @default(0) @map("sort_order")
  treePath  String? @map("tree_path")
  statusCode String @default("new") @map("status")  // → imp_asset_status_types.code
  technicalData Json @default("{}") @map("technical_data")
  notes String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  createdBy String?   @map("created_by") @db.Uuid
  deviceId  String?   @map("device_id")
  deletedAt DateTime? @map("deleted_at")

  organization       Organization        @relation(fields: [orgId], references: [id])
  inspectionPlan     InspectionPlan      @relation(fields: [inspectionPlanId], references: [id], onDelete: Cascade)
  parentAsset        Asset?              @relation("AssetHierarchy", fields: [parentAssetId], references: [id])
  childAssets        Asset[]             @relation("AssetHierarchy")
  location           InspectionLocation? @relation("AssetLocation", fields: [locationId], references: [id])
  createdByUser      User?               @relation("AssetCreatedBy", fields: [createdBy], references: [id])
  visualInspections  VisualInspection[]
  measurementRecords MeasurementRecord[]
  findings           Finding[]
  measurementSheetRecords MeasurementSheetRecord[]
  markers            LocationImageMarker[]
  linkedMeasurements StandaloneMeasurement[] @relation("LinkedAsset")

  @@index([orgId])
  @@index([inspectionPlanId])
  @@map("imp_assets")
}

model VisualInspection {
  id      String @id @default(uuid()) @db.Uuid
  orgId   String @map("org_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid

  status           InspectionExecStatus @default(not_started)
  checklistResults Json                 @default("[]") @map("checklist_results")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  inspectorId String?   @map("inspector_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deviceId  String?   @map("device_id")

  organization Organization @relation(fields: [orgId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspector    User?        @relation("VisualInspectionInspector", fields: [inspectorId], references: [id])
  findings     Finding[]

  @@index([orgId])
  @@index([assetId])
  @@map("imp_visual_inspections")
}

model MeasurementRecord {
  id      String @id @default(uuid()) @db.Uuid
  orgId   String @map("org_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid

  status       InspectionExecStatus @default(not_started)
  measurements Json                 @default("[]")

  instrumentType   String?   @map("instrument_type")
  instrumentSerial String?   @map("instrument_serial")
  calibrationDate  DateTime? @map("calibration_date") @db.Date

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  inspectorId String?   @map("inspector_id") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  deviceId  String?   @map("device_id")

  organization Organization @relation(fields: [orgId], references: [id])
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  inspector    User?        @relation("MeasurementRecordInspector", fields: [inspectorId], references: [id])
  findings     Finding[]

  @@index([orgId])
  @@index([assetId])
  @@map("imp_measurement_records")
}

model Finding {
  id                  String  @id @default(uuid()) @db.Uuid
  orgId               String  @map("org_id") @db.Uuid
  assetId             String  @map("asset_id") @db.Uuid
  visualInspectionId  String? @map("visual_inspection_id") @db.Uuid
  measurementRecordId String? @map("measurement_record_id") @db.Uuid
  findingTemplateId   String? @map("finding_template_id") @db.Uuid

  inspectionType FindingInspectionType @map("inspection_type")

  shortDescription String  @map("short_description")
  longDescription  String? @map("long_description")
  classificationValues Json @default("{}") @map("classification_values")

  locationDescription String? @map("location_description")
  locationMarker      Json?   @map("location_marker")

  recommendation       String?
  recommendationCustom String? @map("recommendation_custom")
  normReference   String? @map("norm_reference")
  checklistItemId String? @map("checklist_item_id") @db.Uuid

  statusCode      String     @default("open") @map("status")  // → imp_finding_status_types.code
  resolvedAt      DateTime?  @map("resolved_at")
  resolvedBy      String?    @map("resolved_by") @db.Uuid
  resolutionNotes String?    @map("resolution_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  syncedAt  DateTime? @map("synced_at")
  createdBy String?   @map("created_by") @db.Uuid
  deviceId  String?   @map("device_id")
  deletedAt DateTime? @map("deleted_at")

  organization      Organization       @relation(fields: [orgId], references: [id])
  asset             Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  visualInspection  VisualInspection?  @relation(fields: [visualInspectionId], references: [id])
  measurementRecord MeasurementRecord? @relation(fields: [measurementRecordId], references: [id])
  findingTemplate   FindingTemplate?   @relation(fields: [findingTemplateId], references: [id])
  createdByUser     User?              @relation("FindingCreatedBy", fields: [createdBy], references: [id])
  resolvedByUser    User?              @relation("FindingResolvedBy", fields: [resolvedBy], references: [id])
  resolutions       FindingResolution[]
  markers           LocationImageMarker[]

  @@index([orgId])
  @@index([assetId])
  @@index([findingTemplateId])
  @@map("imp_findings")
}

model Photo {
  id String @id @default(uuid()) @db.Uuid
  orgId String @map("org_id") @db.Uuid

  entityType PhotoEntityType @map("entity_type")
  entityId   String          @map("entity_id") @db.Uuid

